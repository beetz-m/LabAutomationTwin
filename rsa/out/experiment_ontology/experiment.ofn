SubClassOf(xp:Administration ObjectIntersectionOf(xp:PlannedProcess ObjectExactCardinality(1 xp:executes xp:AdministrationSpecification) ObjectSomeValuesFrom(xp:hasSpecifiedInput xp:ChemicalAgent) ObjectSomeValuesFrom(xp:hasSpecifiedInput xp:ExperimentalUnit)))
