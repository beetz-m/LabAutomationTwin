    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ChemicalAgent"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#bearerOf"/>
          <owl:someValuesFrom rdf:resource="#ChallengeAgentRole"/>
