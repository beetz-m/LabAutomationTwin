</owl:Class>

<owl:Class rdf:about="#Cell">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf rdf:resource="#MaterialEntity"/>
</owl:Class>

<owl:Class rdf:about="#ChemicalAgent">
