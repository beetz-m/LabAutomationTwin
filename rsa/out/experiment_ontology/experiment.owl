  <rdfs:subClassOf rdf:resource="#InformationContentEntity"/>
</owl:Class>

<owl:Class rdf:about="#Hypothesis">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf rdf:resource="#InformationContentEntity"/>
</owl:Class>

<owl:Class rdf:about="#Objective">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf rdf:resource="#InformationContentEntity"/>
</owl:Class>

<owl:Class rdf:about="#Conclusion">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf rdf:resource="#InformationContentEntity"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#derivedFrom"/>
      <owl:someValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#EffectEstimate"/>
            <rdf:Description rdf:about="#PosteriorDistribution"/>
          </owl:unionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#OrganoidCulture">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#MaterialEntity"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasOrganoid"/>
          <owl:someValuesFrom rdf:resource="#Organoid"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasMedium"/>
          <owl:someValuesFrom rdf:resource="#CultureMedium"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Organoid">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
