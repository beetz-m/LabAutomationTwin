    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#MaterialEntity"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasCell"/>
          <owl:someValuesFrom rdf:resource="#Cell"/>
