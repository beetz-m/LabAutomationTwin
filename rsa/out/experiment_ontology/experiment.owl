</owl:Class>

<owl:Class rdf:about="#BiologicalProcess">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf rdf:resource="#Process"/>
</owl:Class>

<owl:Class rdf:about="#PlanSpecification">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf rdf:resource="#InformationContentEntity"/>
</owl:Class>

<owl:Class rdf:about="#DataItem">
