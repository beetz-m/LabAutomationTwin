<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://aicor.example/okf/experiment"
         xmlns="https://aicor.example/okf/experiment#">

<owl:Ontology rdf:about="https://aicor.example/okf/experiment"/>

<owl:ObjectProperty rdf:about="#hasPart">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <owl:inverseOf rdf:resource="#partOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#partOf">
  <owl:inverseOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasPhase">
  <rdfs:subPropertyOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasStep">
  <rdfs:subPropertyOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasWell">
  <rdfs:subPropertyOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasOrganoid">
  <rdfs:subPropertyOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCell">
  <rdfs:subPropertyOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasMedium">
  <rdfs:subPropertyOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasArm">
  <rdfs:subPropertyOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasComparisonSpec">
  <rdfs:subPropertyOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasAdministrationSpec">
  <rdfs:subPropertyOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasObjective">
  <rdfs:subPropertyOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#contains">
  <owl:inverseOf rdf:resource="#containedIn"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#containedIn">
  <owl:inverseOf rdf:resource="#contains"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#locatedIn">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#containedIn"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#partOf"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasParticipant">
  <owl:inverseOf rdf:resource="#participatesIn"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#hasPart"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#hasParticipant"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#participatesIn">
  <owl:inverseOf rdf:resource="#hasParticipant"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSpecifiedInput">
  <rdfs:subPropertyOf rdf:resource="#hasParticipant"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#bearerOf">
  <owl:inverseOf rdf:resource="#inheresIn"/>
  <rdfs:domain rdf:resource="#Continuant"/>
  <rdfs:range rdf:resource="#SpecificallyDependentContinuant"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inheresIn">
  <owl:inverseOf rdf:resource="#bearerOf"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#assignedTo">
  <owl:inverseOf rdf:resource="#hasAssignedUnit"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasAssignedUnit">
  <owl:inverseOf rdf:resource="#assignedTo"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#usesAgent">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#precedes">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#executes">
  <rdfs:domain rdf:resource="#PlannedProcess"/>
  <rdfs:range rdf:resource="#PlanSpecification"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isAbout">
  <rdfs:domain rdf:resource="#InformationContentEntity"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#realizedIn">
  <rdfs:domain rdf:resource="#RealizableEntity"/>
  <rdfs:range rdf:resource="#Process"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#compares"/>

<owl:ObjectProperty rdf:about="#hasLevel">
  <owl:inverseOf rdf:resource="#levelOf"/>
  <rdfs:subPropertyOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#levelOf">
  <owl:inverseOf rdf:resource="#hasLevel"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasFactor">
  <rdfs:subPropertyOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#atLevel"/>

<owl:ObjectProperty rdf:about="#contrasts"/>

<owl:ObjectProperty rdf:about="#differenceOf"/>

<owl:ObjectProperty rdf:about="#hasInteractionContrast">
  <rdfs:subPropertyOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#derivedFrom"/>

<owl:ObjectProperty rdf:about="#hasExpectedOutcome"/>

<owl:ObjectProperty rdf:about="#hasReadout">
  <rdfs:subPropertyOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasAnalysisPlan">
  <rdfs:subPropertyOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDecisionRule">
  <rdfs:subPropertyOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#measures"/>

<owl:ObjectProperty rdf:about="#isProxyFor"/>

<owl:ObjectProperty rdf:about="#appliesTo"/>

<owl:ObjectProperty rdf:about="#hasSpecifiedOutput"/>

<owl:ObjectProperty rdf:about="#posits"/>

<owl:ObjectProperty rdf:about="#delays"/>

<owl:ObjectProperty rdf:about="#hasDevice">
  <rdfs:subPropertyOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#providesEnvironment"/>

<owl:ObjectProperty rdf:about="#hasReadoutBinding"/>

<owl:ObjectProperty rdf:about="#licenses"/>

<owl:DatatypeProperty rdf:about="#dose_au">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#atTime_h">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#fromTime_h">
