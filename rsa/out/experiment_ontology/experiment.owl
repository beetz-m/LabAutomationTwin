</owl:Class>

<owl:Class rdf:about="#Well">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#MaterialEntity"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#contains"/>
          <owl:onClass rdf:resource="#OrganoidCulture"/>
          <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#OrganoidSize">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Quality"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#inheresIn"/>
          <owl:someValuesFrom rdf:resource="#Organoid"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Viability">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Disposition"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#inheresIn"/>
          <owl:someValuesFrom rdf:resource="#OrganoidCulture"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#realizedIn"/>
          <owl:allValuesFrom rdf:resource="#CultureGrowth"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
</owl:Class>

