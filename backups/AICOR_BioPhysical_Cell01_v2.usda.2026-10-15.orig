        def Camera "OverviewCamera"
        {
            float focalLength = 24
            float horizontalAperture = 36
            float verticalAperture = 24
            double3 xformOp:translate = (4.7,-5.7,3.8)
            double3 xformOp:rotateXYZ = (68,0,38)
