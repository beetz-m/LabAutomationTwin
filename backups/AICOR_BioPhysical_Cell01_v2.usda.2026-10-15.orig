#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    custom string aicor:sceneVersion = "2.0"
    custom string aicor:scenePurpose = "Coupled physical-biological robot-scientist simulation"
    custom string aicor:biologicalModelDisclaimer = "Illustrative simulation surrogate; not a validated biomedical model"

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Xform "Looks"
    {
        def Material "Steel"
        {
            token outputs:surface.connect = </World/Looks/Steel/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.45, 0.48)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.22
                token outputs:surface
            }
        }
        def Material "WhitePolymer"
        {
            token outputs:surface.connect = </World/Looks/WhitePolymer/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.84, 0.86, 0.88)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }
        def Material "Glass"
        {
            token outputs:surface.connect = </World/Looks/Glass/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.86, 0.93)
                float inputs:opacity = 0.16
                float inputs:roughness = 0.05
                float inputs:ior = 1.45
                token outputs:surface
            }
        }
        def Material "PlatePlastic"
        {
            token outputs:surface.connect = </World/Looks/PlatePlastic/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.91, 0.93, 0.94)
                float inputs:opacity = 0.45
                float inputs:roughness = 0.18
                float inputs:ior = 1.47
                token outputs:surface
            }
        }
        def Material "Medium"
        {
            token outputs:surface.connect = </World/Looks/Medium/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.48, 0.35)
                float inputs:opacity = 0.48
                float inputs:roughness = 0.12
                float inputs:ior = 1.34
                token outputs:surface
            }
        }
        def Material "OrganoidHealthy"
        {
            token outputs:surface.connect = </World/Looks/OrganoidHealthy/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.47, 0.64, 0.39)
                float inputs:roughness = 0.48
                token outputs:surface
            }
        }
        def Material "OrganoidInjured"
        {
            token outputs:surface.connect = </World/Looks/OrganoidInjured/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.54, 0.34, 0.28)
                float inputs:roughness = 0.52
                token outputs:surface
            }
        }
        def Material "OrganoidRecovering"
        {
            token outputs:surface.connect = </World/Looks/OrganoidRecovering/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.52, 0.70, 0.48)
                float inputs:roughness = 0.44
                token outputs:surface
            }
        }
    }

