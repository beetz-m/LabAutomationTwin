                            double3 xformOp:translate = (0, 0, 0.0024)
                            uniform token[] xformOpOrder = ["xformOp:translate"]
                            rel material:binding = </World/Looks/Medium>
                            custom string sdt:materialRole = "culture_medium"
                        }

                        def Sphere "Organoid"
                        {
                            double radius = 0.0016
                            token visibility = "invisible"
                            double3 xformOp:translate = (0, 0, 0.0048)
                            uniform token[] xformOpOrder = ["xformOp:translate"]
                            rel material:binding = </World/Looks/OrganoidHealthy>
                            custom string sdt:renderRole = "biological_state_visualization"
                        }
                    }

                    def Xform "Biological"
                    {
                        custom string sdt:role = "dynamic_biological_state"
                        def Xform "LatentState" {}
                        def Xform "InterventionHistory" {}
                        def Xform "ObservationState" {}
                        def Xform "QualityAndUncertainty" {}
                    }

                    def Xform "Interfaces"
                    {
                        def Xform "pipette_target_frame"
                        {
                            double3 xformOp:translate = (0, 0, 0.010)
                            uniform token[] xformOpOrder = ["xformOp:translate"]
                            custom string sdt:interaction = "aspirate_or_dispense"
                        }
                        def Xform "imaging_target_frame"
                        {
                            double3 xformOp:translate = (0, 0, 0.005)
                            uniform token[] xformOpOrder = ["xformOp:translate"]
                            custom string sdt:interaction = "image_well"
                        }
                    }
                }

                }
            }
        }
    }

    def Xform "ProcessModels"
    {
        def Xform "PhysicalProcesses"
