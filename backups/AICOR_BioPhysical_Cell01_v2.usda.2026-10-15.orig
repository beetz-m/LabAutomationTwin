            }
            def Xform "Pipetting"
            {
                custom string process:type = "hybrid_physical_process"
                custom double process:aspirationHeight_m = 0.004
                custom double process:dispenseHeight_m = 0.008
                custom string process:liquidModel = "kinematic_volume_transfer_v0"
            }
            def Xform "Incubation"
            {
                custom string process:type = "environmental_regulation"
            }
            def Xform "Imaging"
            {
                custom string process:type = "measurement_process"
            }
        }

        def Xform "BiologicalProcesses"
        {
            custom string bio:modelId = "illustrative_surrogate_v0"
            custom string bio:modelScope = "demonstration of coupled state evolution, not biomedical prediction"

            def Xform "CultureGrowth"
            {
                custom string bio:stateVariables = "morphologyRadius_um,viability"
            }
            def Xform "ChallengeResponse"
            {
                custom string bio:stateVariables = "injury,glutathione,viability"
            }
            def Xform "ProtectiveResponse"
            {
                custom string bio:stateVariables = "protectiveResponse"
            }
            def Xform "RescueResponse"
            {
                custom string bio:stateVariables = "injury,glutathione,viability,recoveryProbability"
            }
            def Xform "Phototoxicity"
            {
                custom string bio:stateVariables = "imagingDose,viability"
            }
        }

        def Xform "ObservationModels"
        {
            def Xform "BrightFieldMorphology"
            {
                custom string obs:maps = "morphologyRadius_um,viability -> image descriptors"
            }
            def Xform "FluorescenceBiomarker"
            {
                custom string obs:maps = "glutathione,viability -> fluorescence intensity"
            }
            def Xform "QualityControl"
            {
                custom string obs:maps = "focus,identity,calibration,seating -> measurement validity"
            }
        }
    }

    def Xform "Experiment"
