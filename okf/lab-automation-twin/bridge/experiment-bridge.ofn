Prefix(:=<http://aicor.knowledge/l2-ontology.owl#>)
Prefix(xp:=<https://aicor.example/okf/experiment#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)

Ontology(<https://aicor.example/okf/lab-automation-twin/experiment-bridge>
Annotation(rdfs:comment "Primitive correspondences between lab-twin-culture-experiments and the experiment ontology (rsa/experiment_ontology.py); defined classes are inferred, not asserted.")
EquivalentClasses(Annotation(rdfs:comment "a group of units treated alike = an arm specification") :ExperimentalArm xp:ArmSpecification)
EquivalentClasses(Annotation(rdfs:comment "a planned intervention (agent, dose, time)") :InterventionSpec xp:AdministrationSpecification)
EquivalentClasses(Annotation(rdfs:comment "a planned dose of the challenge agent") :ChallengeSpec xp:ChallengeSpec)
EquivalentClasses(Annotation(rdfs:comment "a planned dose of the rescue agent") :RescueSpec xp:RescueSpec)
SubClassOf(:StudyDesign xp:StudyDesign)
SubClassOf(:ObservationSchedule xp:PlanSpecification)
SubClassOf(:ChallengeIntervention xp:ChallengeAdministration)
SubClassOf(:RescueIntervention xp:RescueAdministration)
SubClassOf(:ScientificHypothesis xp:Hypothesis)
SubClassOf(:ScientificConclusion xp:Conclusion)
SubClassOf(:CultureExperimentRun xp:Investigation)
SubClassOf(:Well xp:Well)
SubClassOf(:WellOrganoid xp:Organoid)
EquivalentObjectProperties(:hasArm xp:hasArm)
EquivalentObjectProperties(:appliesIntervention xp:hasAdministrationSpec)
EquivalentObjectProperties(:assignsUnit xp:hasAssignedUnit)
SubObjectPropertyOf(:runOfStudy xp:executes)
)
