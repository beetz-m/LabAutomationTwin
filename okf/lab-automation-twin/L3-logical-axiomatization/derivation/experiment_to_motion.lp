% =====================================================================================================================
% Experiment-to-motion derivation (clingo). Executable form of axioms/experiment-to-motion-axioms.md (E2M1-E2M8).
% The stable model IS the derived plan: selected experiment, wells, sessions, trips, routes, and the ordered motion /
% device-command designators of every trip. Facts (the lab's ontology ABox, the EIG candidates, twin durations, device
% states) are generated by derive_plan.py.
%
% Fact schema
%   cand(C, DoseCentiAU, DelayH, Reps, EigMilliBits)   req(MilliBits)   window(S)   rescue_au(CentiAU)
%   free(W, Index)   well_pose(W, pipette|imaging, Pose)
%   automated(V)   has_function(V, F)   home(V)   holds_plate(V)   seat(V, Pose)   has_shuttle(V)   airspace(V)
%   serves(R, V)   requires_tool(R, T)   coupled(R, T)   tool_pose(T, Pose)   contacts_culture(T)   compatible(T)
%   calibrated(V)   qc_station(Q, V)   interlocks_closed   reagent_pose(challenge|rescue, Pose)   tip_rack(V, Pose)
%   waste(V, Pose)   dur(Kind, DeciSec)   ddur(V, Kind, DeciSec)   leg_part(R, MotionKind, DeciSec)
%   contamination_suspected (only when the culture SDT holds such a claim for the plate)
% Durations are in deciseconds (integers), apportioned from the twin's run traces by derive_plan.py.
% =====================================================================================================================

% ---------------------------------------------------------------------------------------------------- E2M1 selection
{ selected(C) : cand(C,_,_,_,G), req(Q), G >= Q } = 1.
sel(D,Dt,N,G) :- selected(C), cand(C,D,Dt,N,G).

% ---------------------------------------------------------------------------------------------------- E2M3 arms/units
{ role(W,rescued)    : free(W,_) } = N :- sel(_,_,N,_).
{ role(W,comparator) : free(W,_) } = N :- sel(_,_,N,_).
{ role(W,control)    : free(W,_) } = 1.
:- role(W,R1), role(W,R2), R1 != R2.
% symmetry breaking (wells are interchangeable units): the lowest free indices, rescued < comparator < control
used(W) :- role(W,_).
:- used(W2), free(W2,X2), free(W1,X1), X1 < X2, not used(W1).
rorder(rescued,1). rorder(comparator,2). rorder(control,3).
:- role(W1,R1), role(W2,R2), free(W1,X1), free(W2,X2), X1 < X2, rorder(R1,O1), rorder(R2,O2), O1 > O2.
treated(W) :- role(W,rescued).
treated(W) :- role(W,comparator).

% ---------------------------------------------------------------------------------------------------- E2M4 sessions
session(s0, 0).
session(s1, Dt) :- sel(_,Dt,_,_).
session(s2, 72).
mat(s0, dose(W,challenge,D)) :- sel(D,_,_,_), treated(W).
mat(s1, dose(W,rescue,R))    :- rescue_au(R), role(W,rescued).
mat(s2, image(W))            :- role(W,_).
kind(dose(W,X,Y), dose) :- mat(_, dose(W,X,Y)).
kind(image(W), image)   :- mat(_, image(W)).
well_of(dose(W,X,Y), W) :- mat(_, dose(W,X,Y)).
well_of(image(W), W)    :- mat(_, image(W)).

% ---------------------------------------------------------------------------------------------------- E2M5 allocation
fn(dose, dispensing).
fn(image, imaging).
{ op_dev(S,K,V) : automated(V), has_function(V,F) } = 1 :- session(S,_), mat(S,M), kind(M,K), fn(K,F).
:- op_dev(S,K,V1), op_dev(S,K,V2), V1 != V2.
sdev(S,V) :- op_dev(S,_,V).

% trips: a session's material designators are split into trips (S5 may force more than one)
tripno(1..3).
{ in_trip(S,M,K) : tripno(K) } = 1 :- mat(S,M).
trip(S,K) :- in_trip(S,_,K).
:- trip(S,K), K > 1, not trip(S,K-1).

% ---------------------------------------------------------------------------------------------------- E2M6 routes
edge(R,A,B) :- serves(R,A), serves(R,B), A != B, holds_plate(A), holds_plate(B).
reach(A,0) :- home(A).
reach(B,N+1) :- reach(A,N), edge(_,A,B), N < 5.
dist(B,M) :- reach(B,_), M = #min { N : reach(B,N) }.
on_path(T,T) :- sdev(_,T).
{ pred(T,X,A,R) : edge(R,A,X), dist(A,N-1) } = 1 :- on_path(T,X), dist(X,N), N > 0.
on_path(T,A) :- pred(T,_,A,_).
leg(T,I,R,A,X) :- pred(T,X,A,R), dist(X,I).                 % outbound leg I (1-based) towards device T
pathlen(T,L) :- sdev(_,T), dist(T,L).

% ---------------------------------------------------------------------------------------------------- E2M7 refinement
% positions: phase*100000 + leg*1000 + well*10 + sub   (phase 1 start, 2 out, 3 ops, 4 back, 5 home)
step(S,K,10000,  cmd(E,check_interlocks), start)   :- trip(S,K), interlock_monitor(E).
step(S,K,10010,  cmd(H,verify_identity), start)    :- trip(S,K), home(H).
step(S,K,10020,  cmd(H,present), start)            :- trip(S,K), home(H), has_shuttle(H).

% outbound legs: towards the session's device
mot(S,K,I,R,A,B,out) :- trip(S,K), sdev(S,T), leg(T,I,R,A,B).
% return legs: the reverse path, numbered after the outbound ones
mot(S,K,L+1+L-I,R,B,A,back) :- trip(S,K), sdev(S,T), leg(T,I,R,A,B), pathlen(T,L).

base(S,K,I,20000+I*1000) :- mot(S,K,I,_,_,_,out).
base(S,K,I,40000+I*1000) :- mot(S,K,I,_,_,_,back).
first_leg_of(S,K,R,I) :- mot(S,K,I,R,_,_,_), I = #min { J : mot(S,K,J,R,_,_,_) }.
step(S,K,P+5,  tool_couple(R,T,Q), legref(I)) :- first_leg_of(S,K,R,I), base(S,K,I,P), requires_tool(R,T),
                                                not coupled(R,T), tool_pose(T,Q).
step(S,K,P+8,  cmd(A,present), legref(I))           :- mot(S,K,I,R,A,B,back), base(S,K,I,P), has_shuttle(A).
step(S,K,P+10, approach(R,appr(PA)), legref(I))      :- mot(S,K,I,R,A,B,_), base(S,K,I,P), seat(A,PA).
step(S,K,P+20, insert(R,PA), legref(I))              :- mot(S,K,I,R,A,B,_), base(S,K,I,P), seat(A,PA).
step(S,K,P+30, grasp(R), legref(I))                  :- mot(S,K,I,R,A,B,_), base(S,K,I,P).
step(S,K,P+40, lift(R), legref(I))                   :- mot(S,K,I,R,A,B,_), base(S,K,I,P).
step(S,K,P+45, cmd(A,stow), legref(I))               :- mot(S,K,I,R,A,B,_), base(S,K,I,P), has_shuttle(A).
step(S,K,P+50, transit(R,appr(PA),appr(PB)), legref(I)) :- mot(S,K,I,R,A,B,_), base(S,K,I,P), seat(A,PA), seat(B,PB).
step(S,K,P+55, cmd(B,present), legref(I))            :- mot(S,K,I,R,A,B,_), base(S,K,I,P), has_shuttle(B).
step(S,K,P+60, approach(R,appr(PB)), legref(I))      :- mot(S,K,I,R,A,B,_), base(S,K,I,P), seat(B,PB).
step(S,K,P+70, place(R,PB), legref(I))               :- mot(S,K,I,R,A,B,_), base(S,K,I,P), seat(B,PB).
step(S,K,P+80, release(R), legref(I))                :- mot(S,K,I,R,A,B,_), base(S,K,I,P).
step(S,K,P+90, retract(R,appr(PB)), legref(I))       :- mot(S,K,I,R,A,B,_), base(S,K,I,P), seat(B,PB).

% device operations (phase 3), one block per material designator, ordered by well index
widx(M,X) :- well_of(M,W), free(W,X).
step(S,K,30000+X*10+1, cmd(V,tip_pick(Q)), op(M))    :- in_trip(S,M,K), kind(M,dose), sdev(S,V), tip_rack(V,Q), widx(M,X).
step(S,K,30000+X*10+2, cmd(V,aspirate(Q)), op(M))    :- in_trip(S,dose(W,Rg,A),K), M=dose(W,Rg,A), sdev(S,V),
                                                        reagent_pose(Rg,Q), widx(M,X).
step(S,K,30000+X*10+3, cmd(V,dispense(Q,A)), op(M))  :- in_trip(S,dose(W,Rg,A),K), M=dose(W,Rg,A), sdev(S,V),
                                                        well_pose(W,pipette,Q), widx(M,X).
step(S,K,30000+X*10+4, cmd(V,tip_eject(Q)), op(M))   :- in_trip(S,M,K), kind(M,dose), sdev(S,V), waste(V,Q), widx(M,X).
step(S,K,30005, cmd(V,load), load)                   :- trip(S,K), in_trip(S,M,K), kind(M,image), sdev(S,V).
step(S,K,30000+X*10+5, cmd(V,image_well(Q)), op(M))  :- in_trip(S,image(W),K), M=image(W), sdev(S,V),
                                                        well_pose(W,imaging,Q), widx(M,X).
% S3 discharge: a QC validation of an uncalibrated imager as a PREPARATION step (phase 0, position 5000): the reference
% plate needs the imager's stage, so it runs before the experiment plate leaves its home; it does not count against the
% window outside the incubator (rsa kernel iteration 2, finding F11: at 30001 the plate already occupied L17).
step(S,K,5000, cmd(Qs,validate(V)), safety(l17_calibration_valid)) :- trip(S,K), sdev(S,V), has_function(V,imaging),
                                                                      not calibrated(V), qc_station(Qs,V).
% S2 discharge: wait for the home environment, then store (phase 5)
step(S,K,50000, cmd(H,wait_environment), safety(l10_environment_valid)) :- trip(S,K), home(H).
step(S,K,50010, cmd(H,store), home)                  :- trip(S,K), home(H).

% ---------------------------------------------------------------------------------------------------- E2M8 safety
% relax(sN) is never asserted by a derivation; derive_plan.py adds it only to DIAGNOSE a refusal (which rule blocks).
#defined relax/1. #defined coupled/2. #defined compatible/1. #defined contamination_suspected/0. #defined calibrated/1.
#defined interlocks_closed/0. #defined contacts_culture/1. #defined has_shuttle/1. #defined airspace/1.
% (S1) deck airspace: between a robot's place into a device with an airspace and that device's first op, the robot
%      retracts.
place_at(S,K,R,V,P) :- step(S,K,P,place(R,Q),_), seat(V,Q), airspace(V).
retract_at(S,K,R,V,P) :- step(S,K,P,retract(R,appr(Q)),_), seat(V,Q), airspace(V).
devop_at(S,K,V,P) :- step(S,K,P,cmd(V,X),op(_)), airspace(V).
cleared(S,K,R,V,P1,P2) :- place_at(S,K,R,V,P1), devop_at(S,K,V,P2), retract_at(S,K,R,V,P3), P1 < P3, P3 < P2.
:- place_at(S,K,R,V,P1), devop_at(S,K,V,P2), P1 < P2, not cleared(S,K,R,V,P1,P2), not relax(s1).
% (S2) environment before store
waited(S,K,P) :- step(S,K,P,cmd(H,store),_), step(S,K,P2,cmd(H,wait_environment),_), P2 < P.
:- step(S,K,P,cmd(H,store),_), home(H), not waited(S,K,P), not relax(s2).
% (S3) calibration before imaging
qc_before(S,K,P) :- step(S,K,P,cmd(V,image_well(_)),_), step(S,K,P2,cmd(_,validate(V)),_), P2 < P.
:- step(S,K,P,cmd(V,image_well(_)),_), not calibrated(V), not qc_before(S,K,P), not relax(s3).
% (S4) tool compatibility
:- step(_,_,_,tool_couple(_,T,_),_), contacts_culture(T), not compatible(T), not relax(s4).
% (S6) interlocks
:- not interlocks_closed, not relax(s6).
% (S8) contamination: no challenge / rescue is derived on a plate under suspected contamination
:- contamination_suspected, mat(_, dose(_,_,_)), not relax(s8).
% (S9) control structure: a challenge is authorised only with a control (rule challenge_requires_controls)
has_control :- role(_,control).
:- mat(_, dose(_,challenge,_)), not has_control, not relax(s9).
% (S7) identity first
:- trip(S,K), not step(S,K,10010,cmd(_,verify_identity),start), not relax(s7).
% (S5) time outside the incubator per trip
dev_of(cmd(V,X), V) :- step(_,_,_,cmd(V,X),_).
has_ddur(A) :- step(_,_,_,A,_), akind(A,Kd), dev_of(A,V), ddur(V,Kd,_).
sdur(S,K,P,Du) :- step(S,K,P,A,_), akind(A,Kd), dev_of(A,V), ddur(V,Kd,Du).
sdur(S,K,P,Du) :- step(S,K,P,A,_), akind(A,Kd), dur(Kd,Du), not has_ddur(A).
sdur(S,K,P,Du) :- step(S,K,P,A,legref(I)), mot(S,K,I,R,_,_,_), mkind(A,Mk), leg_part(R,Mk,Du).
% robust: the trip must fit even if every step takes margin_pct % longer than its trace estimate
:- trip(S,K), window(Wn), margin_pct(M), #sum { Du*(100+M),P : sdur(S,K,P,Du), P >= 10000 } > Wn*100, not relax(s5).

akind(cmd(X1,check_interlocks),check) :- step(_,_,_,cmd(X1,check_interlocks),_).
akind(cmd(X1,verify_identity),identity) :- step(_,_,_,cmd(X1,verify_identity),_).
akind(cmd(X1,present),present) :- step(_,_,_,cmd(X1,present),_).
akind(cmd(X1,stow),stow) :- step(_,_,_,cmd(X1,stow),_).
akind(cmd(X1,tip_pick(X2)),tip_pick) :- step(_,_,_,cmd(X1,tip_pick(X2)),_).
akind(cmd(X1,aspirate(X2)),aspirate) :- step(_,_,_,cmd(X1,aspirate(X2)),_).
akind(cmd(X1,dispense(X2,X3)),dispense) :- step(_,_,_,cmd(X1,dispense(X2,X3)),_).
akind(cmd(X1,tip_eject(X2)),tip_eject) :- step(_,_,_,cmd(X1,tip_eject(X2)),_).
akind(cmd(X1,load),load) :- step(_,_,_,cmd(X1,load),_).
akind(cmd(X1,image_well(X2)),image) :- step(_,_,_,cmd(X1,image_well(X2)),_).
akind(cmd(X1,validate(X2)),qc) :- step(_,_,_,cmd(X1,validate(X2)),_).
akind(cmd(X1,wait_environment),wait_env) :- step(_,_,_,cmd(X1,wait_environment),_).
akind(cmd(X1,store),store) :- step(_,_,_,cmd(X1,store),_).
akind(tool_couple(X1,X2,X3),tool_couple) :- step(_,_,_,tool_couple(X1,X2,X3),_).
mkind(approach(X1,X2),approach) :- step(_,_,_,approach(X1,X2),_).
mkind(insert(X1,X2),insert) :- step(_,_,_,insert(X1,X2),_).
mkind(grasp(X1),grasp) :- step(_,_,_,grasp(X1),_).
mkind(lift(X1),lift) :- step(_,_,_,lift(X1),_).
mkind(transit(X1,X2,X3),transit) :- step(_,_,_,transit(X1,X2,X3),_).
mkind(place(X1,X2),place) :- step(_,_,_,place(X1,X2),_).
mkind(release(X1),release) :- step(_,_,_,release(X1),_).
mkind(retract(X1,X2),retract) :- step(_,_,_,retract(X1,X2),_).

% ---------------------------------------------------------------------------------------------------- E2M1 cost
% cost = robot / device time of every trip + 60 s per well used (a consumable / occupancy weight)
#minimize { Du@2,S,K,P : sdur(S,K,P,Du) ; 600@2,W : role(W,_) }.
#maximize { G@1 : sel(_,_,_,G) }.

#show selected/1. #show sel/4. #show role/2. #show session/2. #show mat/2. #show op_dev/3. #show in_trip/3.
#show trip/2. #show step/5. #show sdur/4. #show leg/5.
