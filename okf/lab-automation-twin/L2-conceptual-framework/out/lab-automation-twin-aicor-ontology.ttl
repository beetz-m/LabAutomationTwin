            owl:someValuesFrom :dul_PhysicalObject ],
        :SpatialPose,
        owl:Thing .

:mitigatesHazard a owl:ObjectProperty .

:LabHazard a owl:Class ;
    rdfs:label "LabHazard"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hazardTo ;
            owl:someValuesFrom :Entity ],
        :dul_Description,
        owl:Thing .

:RobotBody a owl:Class ;
    rdfs:label "RobotBody"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasEndEffector ;
            owl:someValuesFrom :EndEffector ],
        [ a owl:Restriction ;
            owl:onProperty :hasJoint ;
            owl:someValuesFrom :Joint ],
        [ a owl:Restriction ;
            owl:onProperty :hasSensor ;
            owl:someValuesFrom :Sensor ],
        [ a owl:Restriction ;
            owl:onProperty :hasLink ;
            owl:someValuesFrom :Link ],
        [ a owl:Restriction ;
            owl:onProperty :generates ;
            owl:someValuesFrom :BodyMotion ],
        :ArticulatedObject,
        :PhysicalEntity,
        owl:Thing ;
    owl:disjointWith :WorldPhysicalEntity .

:TimeInterval a owl:Class ;
    rdfs:label "TimeInterval"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasStart ;
            owl:someValuesFrom :TimeInstant ],
        [ a owl:Restriction ;
            owl:onProperty :hasEnd ;
            owl:someValuesFrom :TimeInstant ],
        :AbstractEntity,
        :dul_Region,
        owl:Thing ;
    owl:disjointWith :Chronicle,
        :EventType,
        :FluentType,
        :Occasion,
        :Occurrence .

:refinesInto a owl:ObjectProperty .

:Entity a owl:Class ;
    rdfs:label "Entity"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( :PhysicalEntity :AbstractEntity ) ],
        owl:Thing .

:InteractionPose a owl:Class ;
    rdfs:label "InteractionPose"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :affordsTaskType ;
            owl:someValuesFrom :LabTaskType ],
        :TwinPose,
        owl:Thing .

:MotionStepDesignator a owl:Class ;
    rdfs:label "MotionStepDesignator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :performedByRobot ;
            owl:someValuesFrom :CellRobot ],
        [ a owl:Restriction ;
            owl:onProperty :primitiveName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty :estimatedDuration_s ;
            owl:someValuesFrom xsd:decimal ],
        :BodyMotionDesignator,
        :LabActionDesignator,
        owl:Thing ;
    owl:disjointWith :DeviceCommandDesignator .

:DeviceFunction a owl:Class ;
    rdfs:label "DeviceFunction"^^xsd:string ;
    rdfs:subClassOf :dul_Quality,
        owl:Thing .

:PhysicalEntity a owl:Class ;
    rdfs:subClassOf :Entity ;
    owl:disjointWith :AbstractEntity .

:designatesAction a owl:ObjectProperty .

:functionAffords a owl:ObjectProperty .

:EvidenceBearingTrace a owl:Class ;
    rdfs:label "EvidenceBearingTrace"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isRawLog ],
        [ a owl:Restriction ;
            owl:onProperty :relativeTo ;
            owl:someValuesFrom :AssessmentRegime ],
        [ a owl:Restriction ;
            owl:onProperty :interprets ;
            owl:someValuesFrom :Recording ],
        [ a owl:Restriction ;
            owl:onProperty :partOfScientificObject ;
            owl:someValuesFrom :ScientificObject ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isCriticRelative ],
        [ a owl:Restriction ;
            owl:onProperty :records ;
            owl:someValuesFrom :ManipulationEpisode ],
        :CaseLevelEntity,
        :dul_InformationObject,
        owl:Thing ;
    owl:disjointWith :ManipulationEpisode,
        :Recording .

:LabAction a owl:Class ;
    rdfs:label "LabAction"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :executesTaskType ;
            owl:someValuesFrom :LabTaskType ],
        :soma_Action,
        owl:Thing .

:ManipulationProblemClass a owl:Class ;
    rdfs:label "ManipulationProblemClass"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :NuisanceModel ;
            owl:onProperty :hasNuisanceModel ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :MasteryCriterion ;
            owl:onProperty :hasMasteryCriterion ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isRWMSComponent ],
        [ a owl:Restriction ;
            owl:onClass :RWMSFamily ;
            owl:onProperty :hasRWMSFamily ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :specifiedBy ;
            owl:someValuesFrom :ProblemClassSpecificationTemplate ],
        [ a owl:Restriction ;
            owl:onClass :TaskScope ;
            owl:onProperty :hasTaskScope ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :constrainsRung ;
            owl:someValuesFrom :SubstrateRung ],
        [ a owl:Restriction ;
            owl:onProperty :generates ;
            owl:someValuesFrom :ProblemDomain ],
        [ a owl:Restriction ;
            owl:onProperty :hasCriticSet ;
            owl:someValuesFrom :Critic ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isGenerator ],
        :AbstractEntity,
        :MetaLevelEntity,
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :ProblemDomain .

:affordsTaskType a owl:ObjectProperty .

:ManipulationEpisode a owl:Class ;
    rdfs:label "ManipulationEpisode"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :StateEstimate ;
            owl:onProperty :hasStateEstimate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :TaskRequest ;
            owl:onProperty :hasRequest ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :hasLifecycleEvents ;
            owl:someValuesFrom :LifecycleEvent ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :TaskEnvironmentEmbodimentClass ;
            owl:onProperty :conformsToScope ],
        [ a owl:Restriction ;
            owl:onClass :ForceDynamicSchema ;
            owl:onProperty :satisfies ;
            owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :BodyWorldTrajectory ;
            owl:onProperty :hasPhysicalCore ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :isRunOf ;
            owl:someValuesFrom :RobotWorldManipulationSystem ],
        [ a owl:Restriction ;
            owl:onClass :CommitmentRecord ;
            owl:onProperty :hasCommitmentRecord ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :hasTrace ;
            owl:someValuesFrom :EvidenceBearingTrace ],
        [ a owl:Restriction ;
            owl:onClass :TaskReading ;
            owl:onProperty :hasTaskReading ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isHierarchical ],
        [ a owl:Restriction ;
            owl:onClass :Recording ;
            owl:onProperty :hasRecording ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isBounded ],
        [ a owl:Restriction ;
            owl:onProperty :hasVerdictComponent ;
            owl:someValuesFrom :VerdictComponent ],
        [ a owl:Restriction ;
            owl:onClass :TerminalDisposition ;
            owl:onProperty :hasTerminalDisposition ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :AbstractEntity,
        :CaseLevelEntity,
        :dul_Situation,
        owl:Thing ;
    owl:disjointWith :EvidenceBearingTrace,
        :ForceDynamicSchema,
        :Recording .

:MetaLevelEntity a owl:Class ;
    rdfs:label "MetaLevelEntity"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :atCaseLevel ],
        :dul_Entity,
        owl:Thing .

:locatedAt a owl:ObjectProperty .

:LabAutomationDevice a owl:Class ;
    rdfs:label "LabAutomationDevice"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasDeviceFunction ;
            owl:someValuesFrom :DeviceFunction ],
        [ a owl:Restriction ;
            owl:onProperty :hasControlInterface ;
            owl:someValuesFrom :DeviceControlInterface ],
        [ a owl:Restriction ;
            owl:onProperty :modeledInTwin ;
            owl:someValuesFrom :SemanticDigitalTwin ],
        :RealizationSide,
        :TwinEntity,
        :dul_PhysicalObject,
        owl:Thing ;
    owl:disjointWith :RobotBody .

:BodyWorldSystem a owl:Class ;
    rdfs:label "BodyWorldSystem"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasProperPart ;
            owl:someValuesFrom :WorldPhysicalEntity ],
        [ a owl:Restriction ;
            owl:onProperty :hasProperPart ;
            owl:someValuesFrom :RobotBody ],
        [ a owl:Restriction ;
            owl:onProperty :hasCoupling ;
            owl:someValuesFrom :ForceInteraction ],
        [ a owl:Restriction ;
            owl:onProperty :hasDeclaredBoundary ;
            owl:someValuesFrom :DeclaredBoundary ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :boundaryTaskRelative ],
        :CaseLevelEntity,
        :PhysicalEntity,
        :dul_PhysicalObject,
        owl:Thing .

:DeviceCommandDesignator a owl:Class ;
    rdfs:label "DeviceCommandDesignator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :commandsDevice ;
            owl:someValuesFrom :LabAutomationDevice ],
        [ a owl:Restriction ;
            owl:onProperty :primitiveName ;
            owl:someValuesFrom xsd:string ],
        :LabActionDesignator,
        :ScientificActionDesignator,
        owl:Thing .

:LabActionDesignator a owl:Class ;
    rdfs:label "LabActionDesignator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :stepIndex ;
            owl:someValuesFrom xsd:integer ],
        :ScientificActionDesignator,
        owl:Thing .

:LabTaskType a owl:Class ;
    rdfs:label "LabTaskType"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :LabAction ;
            owl:onProperty :classifiesAction ],
        :dul_Concept,
        owl:Thing .

:dul_Event a owl:Class ;
    rdfs:label "dul:Event"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ManipulationExecutive a owl:Class ;
    rdfs:label "ManipulationExecutive"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :controls ;
            owl:someValuesFrom :BodyWorldSystem ],
        [ a owl:Restriction ;
            owl:onProperty :generates ;
            owl:someValuesFrom :ActionToken ],
        [ a owl:Restriction ;
            owl:onProperty :issues ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :WarrantedExecutiveCommitment :Abstention ) ] ],
        [ a owl:Restriction ;
            owl:onProperty :discharges ;
            owl:someValuesFrom :RepresentationalObligation ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isAccountable ],
        :AbstractEntity,
        :CaseLevelEntity,
        :dul_Agent,
        owl:Thing ;
    owl:disjointWith :ProposalMechanism .

:kernelCategory a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:isDirectComponentOf a owl:ObjectProperty .

:MechanismPart a owl:Class ;
    rdfs:label "MechanismPart"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :isDirectComponentOf ;
            owl:someValuesFrom :LabArtifact ],
        :LabArtifact,
        owl:Thing .

:hasDirectComponent a owl:ObjectProperty .

:dul_PhysicalObject a owl:Class ;
    rdfs:label "dul:PhysicalObject"^^xsd:string ;
    rdfs:subClassOf :PhysicalEntity,
        :dul_Object,
        owl:Thing .

:LabArtifact a owl:Class ;
    rdfs:label "LabArtifact"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :isRepresentedBy ;
            owl:someValuesFrom :LabSDTNode ],
        :dul_PhysicalObject,
        owl:Thing .

:dul_InformationObject a owl:Class ;
    rdfs:label "dul:InformationObject"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        :dul_SocialObject,
        owl:Thing .

:AbstractEntity a owl:Class ;
    rdfs:subClassOf :Entity .

:dul_Description a owl:Class ;
    rdfs:label "dul:Description"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        :dul_SocialObject,
        owl:Thing .

[] a owl:AllDisjointClasses ;
    owl:members ( :ForceClosure :Constraint :Process ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :ForceClosure :Constraint :Process ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Outcome :TerminalDisposition :ExecutiveAdequacy :Robustness :Recoverability :EvidentialSufficiency ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Revolute :Prismatic :Spherical :Continuous :Fixed ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Descriptive :Deictic :Relational ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :RoleSlot :ObjectRef :LocationRef :ActionRef :MotionRef :GraspRef :TrajectoryRef :ObservationRef :RepairCandidateRef ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :NoMatch :CapabilityMatch :ProvisionalBinding :ValidatedBinding ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :SourceAndFamily :System :Executive :Task :EpisodeAndTrace :AssessmentAndClaim ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :InitNuisance :ObjectNuisance :PhysicalNuisance :SensingNuisance :ActuationNuisance :LayoutNuisance :HumanNuisance :TaskNuisance :DisturbanceNuisance ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Structural :Generative :Coupling :Grounding :ProposalCommitment :Realization :CausalEffectiveness :PhysicalCausal :Recording :Evaluation :Support ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( :solution :repaired :prohibited :nonachieving ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :ValidAndInterpretable :InvalidMissingControl :InvalidCalibration :InvalidSampleIdentity :InconclusiveInsufficientEvidence ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :ControlCounterpart :MonitorCounterpart :DiagnosisCounterpart :RevisionCounterpart :EvidenceCounterpart ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :UniqueReferent :CandidateSet :ReferentDistribution :Unresolved ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :SceneNode :LocationRef :ActionRef :MotionRef :GraspRef :TrajectoryRef :ObservationRef :RepairCandidateRef ) .

