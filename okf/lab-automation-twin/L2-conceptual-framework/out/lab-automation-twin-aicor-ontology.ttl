@prefix : <http://aicor.knowledge/l2-ontology.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://aicor.knowledge/l2-ontology.owl> a owl:Ontology .

:AICORReferenceManipulationExecutive a owl:Class ;
    rdfs:label "AICORReferenceManipulationExecutive"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isArchitectureNeutral ],
        [ a owl:Restriction ;
            owl:onClass :ManipulationControlProgram ;
            owl:onProperty :hasProperPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :ManipulationExecutiveOperatingSystem ;
            owl:onProperty :hasProperPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :ManipulationExecutive,
        owl:Thing .

:AMRDispatchBench a owl:Class ;
    rdfs:label "AMRDispatchBench"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :locatedAt ;
            owl:someValuesFrom :StorageRoom ],
        :LabBench,
        owl:Thing .

:AMRRoute a owl:Class ;
    rdfs:label "AMRRoute"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :affordsTaskType ;
            owl:someValuesFrom :NavigationTask ],
        [ a owl:Restriction ;
            owl:onProperty :startsAt ;
            owl:someValuesFrom :Dock ],
        [ a owl:Restriction ;
            owl:onProperty :endsAt ;
            owl:someValuesFrom :Dock ],
        :SpatialPose,
        owl:Thing .

:AMRTransferAction a owl:Class ;
    rdfs:label "AMRTransferAction"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasParticipantEntity ;
            owl:someValuesFrom :SampleTransportAMR ],
        :TransferAction,
        owl:Thing .

:AbstentionSignal a owl:Class ;
    rdfs:label "AbstentionSignal"^^xsd:string ;
    rdfs:subClassOf :Signal,
        owl:Thing .

:AccessControlReader a owl:Class ;
    rdfs:label "AccessControlReader"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :monitorsEntity ;
            owl:someValuesFrom :LabDoor ],
        :SafetyDevice,
        owl:Thing .

:AccessGate a owl:Class ;
    rdfs:label "AccessGate"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :isDirectComponentOf ;
            owl:someValuesFrom :LabAutomationDevice ],
        :MechanismPart,
        owl:Thing .

:AccountabilityClaim a owl:Class ;
    rdfs:label "AccountabilityClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :readsAspect ;
            owl:someValuesFrom :AccountableImplementationStructure ],
        [ a owl:Restriction ;
            owl:hasValue "accountable"^^xsd:string ;
            owl:onProperty :propertyKind ],
        :CompetenceProperty,
        owl:Thing .

:Accounting a owl:Class ;
    rdfs:label "Accounting"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasPrecondition ;
            owl:someValuesFrom :Diagnosis ],
        :CognitiveCapability,
        owl:Thing .

:AchievementMiss a owl:Class ;
    rdfs:label "AchievementMiss"^^xsd:string ;
    rdfs:subClassOf :FailureReason,
        owl:Thing .

:ActionEventType a owl:Class ;
    rdfs:label "ActionEventType"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        :EventType,
        owl:Thing .

:ActionReferent a owl:Class ;
    rdfs:label "ActionReferent"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        owl:Thing .

:ActionRelatedForceCorridor a owl:Class ;
    rdfs:label "ActionRelatedForceCorridor"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ActionRelatedGrasp a owl:Class ;
    rdfs:label "ActionRelatedGrasp"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ActionRelatedMotion a owl:Class ;
    rdfs:label "ActionRelatedMotion"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ActionRelatedPlace a owl:Class ;
    rdfs:label "ActionRelatedPlace"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ActionRelatedPour a owl:Class ;
    rdfs:label "ActionRelatedPour"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ActionSufficiency a owl:Class ;
    rdfs:label "ActionSufficiency"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "action"^^xsd:string ;
            owl:onProperty :sufficiencyKind ],
        :SubstrateSufficiency,
        owl:Thing .

:ActionableKnowledgeGraph a owl:Class ;
    rdfs:label "ActionableKnowledgeGraph"^^xsd:string ;
    rdfs:subClassOf :KnowledgeGraph,
        owl:Thing .

:ActiveStatus a owl:Class ;
    rdfs:label "ActiveStatus"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "active"^^xsd:string ;
            owl:onProperty :statusCode ],
        :TaskStatus,
        owl:Thing .

:Actuating a owl:Class ;
    rdfs:label "Actuating"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :mechanismInput ;
            owl:someValuesFrom :ActionToken ],
        [ a owl:Restriction ;
            owl:onProperty :mechanismOutput ;
            owl:someValuesFrom :BodyMotion ],
        [ a owl:Restriction ;
            owl:onProperty :mechanismRealizedBy ;
            owl:someValuesFrom :ManipulationControlProgram ],
        :ActingMechanism,
        owl:Thing .

:AdmissibleAction a owl:Class ;
    rdfs:label "AdmissibleAction"^^xsd:string ;
    rdfs:subClassOf :CandidateAction,
        owl:Thing .

:AgilentVialsampler a owl:Class ;
    rdfs:label "AgilentVialsampler"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :governedByRegulation ;
            owl:someValuesFrom :IVDRConstraint ],
        [ a owl:Restriction ;
            owl:onProperty :enforcesConstraint ;
            owl:someValuesFrom :InjectionVolumeConstraint ],
        [ a owl:Restriction ;
            owl:onProperty :hasAffordance ;
            owl:someValuesFrom :VialDrawer ],
        [ a owl:Restriction ;
            owl:onProperty :hasControlInterface ;
            owl:someValuesFrom :SiLA2Interface ],
        :MedicalLabDevice,
        :PhysicallyOperatedDevice,
        :SeparationDevice,
        owl:Thing .

:AnswerSubstitution a owl:Class ;
    rdfs:label "AnswerSubstitution"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :answersQuery ;
            owl:someValuesFrom :EntityQuery ],
        [ a owl:Restriction ;
            owl:onProperty :hasBinding ;
            owl:someValuesFrom :Binding ],
        :dul_InformationObject,
        owl:Thing .

:ApplicationCentricMicrotheory a owl:Class ;
    rdfs:label "ApplicationCentricMicrotheory"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :focusesOn ;
            owl:someValuesFrom :ApplicationContext ],
        [ a owl:Restriction ;
            owl:hasValue "application"^^xsd:string ;
            owl:onProperty :microtheoryFocus ],
        :BodyWorldProcessMicrotheory,
        owl:Thing .

:ApproachMotion a owl:Class ;
    rdfs:label "ApproachMotion"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :boundToPose ;
            owl:someValuesFrom :TwinPose ],
        :MotionStepDesignator,
        owl:Thing .

:AprilTagMarker a owl:Class ;
    rdfs:label "AprilTagMarker"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :isDirectComponentOf ;
            owl:someValuesFrom :LabArtifact ],
        :FiducialMarker,
        owl:Thing .

:ArtifactCertification a owl:Class ;
    rdfs:label "ArtifactCertification"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :certifiesArtifact ;
            owl:someValuesFrom :ManipulationExecutive ],
        [ a owl:Restriction ;
            owl:onProperty :overProblemClass ;
            owl:someValuesFrom :ManipulationProblemClass ],
        [ a owl:Restriction ;
            owl:onProperty :hasCertificationKind ;
            owl:someValuesFrom xsd:string ],
        :AbstractEntity,
        :Theorem,
        owl:Thing .

:AspirateCommand a owl:Class ;
    rdfs:label "AspirateCommand"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "aspirate"^^xsd:string ;
            owl:onProperty :kernelCategory ],
        :DeviceCommandDesignator,
        :SubstanceManipulationDesignator,
        :TransformationFacetDesignator,
        owl:Thing .

:Assessing a owl:Class ;
    rdfs:label "Assessing"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :mechanismRealizedBy ;
            owl:someValuesFrom :EvidenceBearingTrace ],
        [ a owl:Restriction ;
            owl:onProperty :mechanismInput ;
            owl:someValuesFrom :ManipulationEpisode ],
        [ a owl:Restriction ;
            owl:onProperty :mechanismOutput ;
            owl:someValuesFrom :Verdict ],
        :EvidentialMechanism,
        owl:Thing .

:AssessmentEvent a owl:Class ;
    rdfs:label "AssessmentEvent"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :AssessmentRegime ;
            owl:onProperty :usesRegime ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :ManipulationCase ;
            owl:onProperty :assessesCase ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Verdict ;
            owl:onProperty :hasVerdict ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :MetaLevelEntity,
        owl:Thing .

:AttributeConstraint a owl:Class ;
    rdfs:label "AttributeConstraint"^^xsd:string ;
    rdfs:subClassOf :dul_InformationObject,
        owl:Thing .

:AuditSealedTemplate a owl:Class ;
    rdfs:label "AuditSealedTemplate"^^xsd:string ;
    rdfs:subClassOf :RequiredTemplate,
        owl:Thing .

:AuditTamperTemplate a owl:Class ;
    rdfs:label "AuditTamperTemplate"^^xsd:string ;
    rdfs:subClassOf :ForbiddenTemplate,
        owl:Thing .

:AuthoredStateChange a owl:Class ;
    rdfs:label "AuthoredStateChange"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :causedByPerform ;
            owl:someValuesFrom :PerformOccurrence ],
        :TaskRelevantStateChange,
        owl:Thing ;
    owl:disjointWith :DisturbanceStateChange .

:AuthorityRole a owl:Class ;
    rdfs:label "AuthorityRole"^^xsd:string ;
    rdfs:subClassOf :LabAgentRole,
        owl:Thing .

:AutofocusCommand a owl:Class ;
    rdfs:label "AutofocusCommand"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "autofocus"^^xsd:string ;
            owl:onProperty :kernelCategory ],
        :DeviceCommandDesignator,
        :OperationFacetDesignator,
        :PerceptionDesignator,
        owl:Thing .

:AutomatedBiologyLab a owl:Class ;
    rdfs:label "AutomatedBiologyLab"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :locatedAt ;
            owl:someValuesFrom :LabPremises ],
        [ a owl:Restriction ;
            owl:onProperty :comprisesCell ;
            owl:someValuesFrom :RobotExperimentCell ],
        :LaboratorySite,
        owl:Thing .

:AutomatedLiquidHandler a owl:Class ;
    rdfs:label "AutomatedLiquidHandler"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasDirectComponent ;
            owl:someValuesFrom :GantryAxis ],
        [ a owl:Restriction ;
            owl:onProperty :hasPhysicalPart ;
            owl:someValuesFrom :PipettingChannel ],
        :DispensingDevice,
        :LabArtifact,
        owl:Thing .

:AutomatedPlateHotel a owl:Class ;
    rdfs:label "AutomatedPlateHotel"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasDeviceFunction ;
            owl:someValuesFrom :PlateStorageFunction ],
        [ a owl:Restriction ;
            owl:onProperty :hasDirectComponent ;
            owl:someValuesFrom :InternalPlateHandler ],
        [ a owl:Restriction ;
            owl:onProperty :hasDirectComponent ;
            owl:someValuesFrom :PlateShuttle ],
        :PlateStorageDevice,
        owl:Thing ;
    owl:disjointWith :AutomatedCO2Incubator .

:AutomaticToolChanger a owl:Class ;
    rdfs:label "AutomaticToolChanger"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :couplesTool ;
            owl:someValuesFrom :ExchangeableTool ],
        :MechanismPart,
        owl:Thing .

:AutomationCell a owl:Class ;
    rdfs:label "AutomationCell"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasDirectComponent ;
            owl:someValuesFrom :LabAutomationDevice ],
        [ a owl:Restriction ;
            owl:onProperty :hasDirectComponent ;
            owl:someValuesFrom :Robot ],
        :LaboratoryCell,
        owl:Thing .

:AwarenessClaim a owl:Class ;
    rdfs:label "AwarenessClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "aware"^^xsd:string ;
            owl:onProperty :propertyKind ],
        [ a owl:Restriction ;
            owl:onProperty :readsAspect ;
            owl:someValuesFrom :ObservationFunction ],
        :CompetenceProperty,
        owl:Thing .

:BarcodeReader a owl:Class ;
    rdfs:label "BarcodeReader"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :monitorsEntity ;
            owl:someValuesFrom :Labware ],
        :DeviceSensor,
        owl:Thing .

:BeliefStateSemanticDigitalTwin a owl:Class ;
    rdfs:label "BeliefStateSemanticDigitalTwin"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :representsForExecutive ;
            owl:someValuesFrom :ManipulationExecutive ],
        [ a owl:Restriction ;
            owl:onProperty :representsSelectedAspectsOf ;
            owl:someValuesFrom :BodyWorldSystem ],
        :SemanticDigitalTwin,
        owl:Thing .

:BindingConfirmationFunction a owl:Class ;
    rdfs:label "BindingConfirmationFunction"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :surfaces ;
            owl:someValuesFrom :BindingLevelFailure ],
        [ a owl:Restriction ;
            owl:hasValue "binding-confirmation"^^xsd:string ;
            owl:onProperty :functionCode ],
        [ a owl:Restriction ;
            owl:onProperty :confirms ;
            owl:someValuesFrom :RoleSlot ],
        :ObservationFunction,
        owl:Thing .

:BiologicalCulture a owl:Class ;
    rdfs:label "BiologicalCulture"^^xsd:string ;
    rdfs:subClassOf :BiologicalSample,
        :MaterialEntity,
        owl:Thing .

:BiomedicalExperiment a owl:Class ;
    rdfs:label "BiomedicalExperiment"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :operatesOnSample ;
            owl:someValuesFrom :BiologicalSample ],
        :AutonomousExperiment,
        owl:Thing .

:BlockedActionRecord a owl:Class ;
    rdfs:label "BlockedActionRecord"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasMonitorResult ;
            owl:someValuesFrom :FailedMonitorResult ],
        :CellActionRecord,
        owl:Thing .

:BodyCentricMicrotheory a owl:Class ;
    rdfs:label "BodyCentricMicrotheory"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :focusesOn ;
            owl:someValuesFrom :RobotBody ],
        [ a owl:Restriction ;
            owl:hasValue "body"^^xsd:string ;
            owl:onProperty :microtheoryFocus ],
        :BodyWorldProcessMicrotheory,
        owl:Thing .

:BodySubstitution a owl:Class ;
    rdfs:label "BodySubstitution"^^xsd:string ;
    rdfs:subClassOf :Substitution,
        owl:Thing .

:BoundVariable a owl:Class ;
    rdfs:label "BoundVariable"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isBound ],
        :QueryVariable,
        owl:Thing ;
    owl:disjointWith :UnboundVariable .

:BrightFieldImager a owl:Class ;
    rdfs:label "BrightFieldImager"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasPhysicalPart ;
            owl:someValuesFrom :ObjectiveTurret ],
        [ a owl:Restriction ;
            owl:onProperty :hasDirectComponent ;
            owl:someValuesFrom :MotorizedStage ],
        [ a owl:Restriction ;
            owl:onProperty :hasDirectComponent ;
            owl:someValuesFrom :FocusDrive ],
        :ImagingDevice,
        :LabArtifact,
        owl:Thing .

:CalibrateDesignator a owl:Class ;
    rdfs:label "CalibrateDesignator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "calibrate"^^xsd:string ;
            owl:onProperty :kernelCategory ],
        [ a owl:Restriction ;
            owl:onProperty :designatesAction ;
            owl:someValuesFrom :QCAction ],
        :KernelLabTaskDesignator,
        :MaintenanceActionDesignator,
        :OperationFacetDesignator,
        owl:Thing .

:CapabilityAssertion a owl:Class ;
    rdfs:label "CapabilityAssertion"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        :BodyWorldConstraint,
        owl:Thing .

:CapabilityClaim a owl:Class ;
    rdfs:label "CapabilityClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :establishedBy ;
            owl:someValuesFrom :ObservedConditionsWarrant ],
        [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isUniversallyQuantified ],
        :ScopedClaim,
        owl:Thing .

:CarrierPresenceSensor a owl:Class ;
    rdfs:label "CarrierPresenceSensor"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :isDirectComponentOf ;
            owl:someValuesFrom :MobileRobotBase ],
        :DeviceSensor,
        owl:Thing .

:CarryoverTemplate a owl:Class ;
    rdfs:label "CarryoverTemplate"^^xsd:string ;
    rdfs:subClassOf :ForbiddenTemplate,
        owl:Thing .

:CausalAdmissibility a owl:Class ;
    rdfs:label "CausalAdmissibility"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "causal"^^xsd:string ;
            owl:onProperty :admissibilityKind ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing .

:CeilingLuminaire a owl:Class ;
    rdfs:label "CeilingLuminaire"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :locatedAt ;
            owl:someValuesFrom :LabCeiling ],
        :BuildingServiceDevice,
        owl:Thing .

:CellComponentContract a owl:Class ;
    rdfs:label "CellComponentContract"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :manufacturerBaseline ;
            owl:someValuesFrom xsd:string ],
        :DeviceManual,
        owl:Thing .

:CellCycleReentry a owl:Class ;
    rdfs:label "CellCycleReentry"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :primes ;
            owl:someValuesFrom :HepatocyteProliferation ],
        :dul_Event,
        owl:Thing .

:Centrifuge a owl:Class ;
    rdfs:label "Centrifuge"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasEquipmentFunction ;
            owl:someValuesFrom :SeparationFunction ],
        :ManualLabEquipment,
        owl:Thing .

:ChallengeDoseDesignator a owl:Class ;
    rdfs:label "ChallengeDoseDesignator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :doseAU ;
            owl:someValuesFrom xsd:decimal ],
        :MaterialStepDesignator,
        owl:Thing .

:ChallengeIntervention a owl:Class ;
    rdfs:label "ChallengeIntervention"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :realizedByAction ;
            owl:someValuesFrom :ScientificActionDesignator ],
        :BiologicalIntervention,
        owl:Thing ;
    owl:disjointWith :RescueIntervention .

:ChallengeReagentPortion a owl:Class ;
    rdfs:label "ChallengeReagentPortion"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :affordsTaskType ;
            owl:someValuesFrom :ChallengeDosingTask ],
        :ReagentPortion,
        owl:Thing ;
    owl:disjointWith :RescueReagentPortion .

:CheckInterlocksCommand a owl:Class ;
    rdfs:label "CheckInterlocksCommand"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "check_interlocks"^^xsd:string ;
            owl:onProperty :kernelCategory ],
        :DeviceCommandDesignator,
        :PerceptionDesignator,
        :SafetyStepDesignator,
        owl:Thing .

:Cholangitis a owl:Class ;
    rdfs:label "Cholangitis"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :inflames ;
            owl:someValuesFrom :BileDuct ],
        [ a owl:Restriction ;
            owl:onProperty :aggravatesCholestasis ;
            owl:someValuesFrom :Cholestasis ],
        [ a owl:Restriction ;
            owl:onProperty :promotesFibrosis ;
            owl:someValuesFrom :LiverFibrosis ],
        [ a owl:Restriction ;
            owl:onProperty :recruits ;
            owl:someValuesFrom :ImmuneCell ],
        :InflammatoryResponse,
        owl:Thing .

:CleaningPointPose a owl:Class ;
    rdfs:label "CleaningPointPose"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :affordsTaskType ;
            owl:someValuesFrom :CleaningTask ],
        :InteractionPose,
        owl:Thing .

:CommitRouting a owl:Class ;
    rdfs:label "CommitRouting"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :routesTo ;
            owl:someValuesFrom :LabSemanticDigitalTwin ],
        :RecordRouting,
        owl:Thing ;
    owl:disjointWith :EscalationRouting,
        :InvalidationRouting,
        :QuarantineRouting .

:CommitmentQuestion a owl:Class ;
    rdfs:label "CommitmentQuestion"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "commitment"^^xsd:string ;
            owl:onProperty :principleTag ],
        :CompetenceQuestion,
        owl:Thing .

:CommittableBodyMotionDesignator a owl:Class ;
    rdfs:label "CommittableBodyMotionDesignator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty :committableValue ],
        :BodyMotionDesignator,
        owl:Thing ;
    owl:disjointWith :ForbiddenBodyMotionDesignator .

:CompetenceStandard a owl:Class ;
    rdfs:label "CompetenceStandard"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isHardConstraint ],
        [ a owl:Restriction ;
            owl:hasValue "competence"^^xsd:string ;
            owl:onProperty :standardCode ],
        :GlobalStandard,
        owl:Thing .

:CompletenessClaim a owl:Class ;
    rdfs:label "CompletenessClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "complete"^^xsd:string ;
            owl:onProperty :propertyKind ],
        [ a owl:Restriction ;
            owl:onProperty :readsAspect ;
            owl:someValuesFrom :ManipulationProblemClass ],
        :CompetenceProperty,
        owl:Thing .

:CompletenessStandard a owl:Class ;
    rdfs:label "CompletenessStandard"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isHardConstraint ],
        [ a owl:Restriction ;
            owl:hasValue "completeness"^^xsd:string ;
            owl:onProperty :standardCode ],
        :GlobalStandard,
        owl:Thing .

:CompletionSignal a owl:Class ;
    rdfs:label "CompletionSignal"^^xsd:string ;
    rdfs:subClassOf :Signal,
        owl:Thing .

:ComponentCompetenceClaim a owl:Class ;
    rdfs:label "ComponentCompetenceClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :requiresDeclaredScope ;
            owl:someValuesFrom :ResponsibleClaimScope ],
        [ a owl:Restriction ;
            owl:onProperty :heldByComponent ;
            owl:someValuesFrom [ a owl:Class ;
