    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :warrantRangesOver ;
            owl:someValuesFrom :ManipulationProblemClass ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :carriesMargin ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :familyDeclaredIndependentlyOfOutcome ],
        :ClaimWarrant,
        owl:Thing .

:Dock a owl:Class ;
    rdfs:label "Dock"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasInteractionPose ;
            owl:someValuesFrom :DockPose ],
        :LabArtifact,
        owl:Thing .

:EvidentialMechanism a owl:Class ;
    rdfs:label "EvidentialMechanism"^^xsd:string ;
    rdfs:subClassOf :ExecutiveMechanism,
        owl:Thing .

:ExperimentalProtocol a owl:Class ;
    rdfs:label "ExperimentalProtocol"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :instantiatedBy ;
            owl:someValuesFrom :ExperimentalWorkflow ],
        :DeviceOperationProgram,
        :dul_Description,
        owl:Thing .

:FailureReason a owl:Class ;
    rdfs:label "FailureReason"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ForwardKinematics a owl:Class ;
    rdfs:label "ForwardKinematics"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :total ],
        [ a owl:Restriction ;
            owl:onProperty :hasCodomain ;
            owl:someValuesFrom :TaskSpace ],
        [ a owl:Restriction ;
            owl:onProperty :definedBy ;
            owl:someValuesFrom :KinematicModel ],
        [ a owl:Restriction ;
            owl:onProperty :hasDomain ;
            owl:someValuesFrom :ConfigurationSpace ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :singleValued ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :InverseKinematics .

:FoundationModelInsertionPoint a owl:Class ;
    rdfs:label "FoundationModelInsertionPoint"^^xsd:string ;
    rdfs:subClassOf :dul_Concept,
        owl:Thing .

:GeneralizedAutomationProgram a owl:Class ;
    rdfs:label "GeneralizedAutomationProgram"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :carriesConstraint ;
            owl:someValuesFrom :LabConstraintSet ],
        :AccountSide,
        :ControlProgram,
        owl:Thing .

:GraspRef a owl:Class ;
    rdfs:label "GraspRef"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:Grounding a owl:Class ;
    rdfs:label "Grounding"^^xsd:string ;
    rdfs:subClassOf :CognitiveCapability,
        owl:Thing .

:IdentityRule a owl:Class ;
    rdfs:label "IdentityRule"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :mitigatesHazard ;
            owl:someValuesFrom :IdentityHazard ],
        :LabSafetyRule,
        owl:Thing ;
    owl:disjointWith :MeasurementValidityRule .

:IncubatingTask a owl:Class ;
    rdfs:label "IncubatingTask"^^xsd:string ;
    rdfs:subClassOf :LabTaskType,
        owl:Thing ;
    owl:disjointWith :CalibratingTask,
        :ImagingTask,
        :LiquidDispensingTask,
        :QuarantiningTask .

:KernelScientificDesignator a owl:Class ;
    rdfs:label "KernelScientificDesignator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :refinesInto ;
            owl:someValuesFrom :LabActionDesignator ],
        :LabActionDesignator,
        owl:Thing ;
    owl:disjointWith :DeviceCommandDesignator,
        :KernelLabTaskDesignator,
        :KernelManipulationDesignator,
        :MotionStepDesignator .

:LabCeiling a owl:Class ;
    rdfs:label "LabCeiling"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hostsObject ;
            owl:someValuesFrom :BuildingServiceDevice ],
        :dul_PhysicalPlace,
        owl:Thing .

:LabRoom a owl:Class ;
    rdfs:label "LabRoom"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :isSubPlaceOf ;
            owl:someValuesFrom :LabPremises ],
        :dul_PhysicalPlace,
        owl:Thing .

:LabSemanticDigitalTwin a owl:Class ;
    rdfs:label "LabSemanticDigitalTwin"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasNodeStructure ;
            owl:someValuesFrom :LabSceneHierarchy ],
        :SemanticDigitalTwin,
        owl:Thing .

:LiverFibrosis a owl:Class ;
    rdfs:label "LiverFibrosis"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :depositsMatrix ;
            owl:someValuesFrom :ExtracellularMatrix ],
        [ a owl:Restriction ;
            owl:onProperty :impedesRegeneration ;
            owl:someValuesFrom :LiverRegeneration ],
        :dul_Event,
        owl:Thing ;
    owl:disjointWith :LiverRegeneration .

:LocationRef a owl:Class ;
    rdfs:label "LocationRef"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ManipulationCase a owl:Class ;
    rdfs:label "ManipulationCase"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :ManipulationProblem ;
            owl:onProperty :hasProblem ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :RobotWorldManipulationSystem ;
            owl:onProperty :hasRWMS ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :CaseLevelEntity,
        owl:Thing .

:MaterialScientificDesignator a owl:Class ;
    rdfs:label "MaterialScientificDesignator"^^xsd:string ;
    rdfs:subClassOf :ScientificActionDesignator,
        owl:Thing .

:MaterialStepDesignator a owl:Class ;
    rdfs:label "MaterialStepDesignator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :refinesInto ;
            owl:someValuesFrom :SceneStepDesignator ],
        :LabActionDesignator,
        :MaterialScientificDesignator,
        owl:Thing ;
    owl:disjointWith :DeviceCommandDesignator,
        :MotionStepDesignator,
        :SceneStepDesignator .

:Microplate a owl:Class ;
    rdfs:label "Microplate"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasDirectComponent ;
            owl:someValuesFrom :Well ],
        :Labware,
        owl:Thing .

:MobileRobotBase a owl:Class ;
    rdfs:label "MobileRobotBase"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasDirectComponent ;
            owl:someValuesFrom :CabinetLid ],
        :RobotBody,
        owl:Thing .

:MotionRef a owl:Class ;
    rdfs:label "MotionRef"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:Observation a owl:Class ;
    rdfs:label "Observation"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        :dul_InformationObject,
        owl:Thing .

:ObservationFunction a owl:Class ;
    rdfs:label "ObservationFunction"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :surfaces ;
            owl:someValuesFrom :TwoLevelFailure ],
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :ForceDynamicEvent .

:ObservationRef a owl:Class ;
    rdfs:label "ObservationRef"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:PartialDescription a owl:Class ;
    rdfs:label "PartialDescription"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :TypeConstraint ;
            owl:onProperty :hasTypeConstraint ],
        [ a owl:Restriction ;
            owl:onProperty :describesAs ;
            owl:someValuesFrom :Designator ],
        :dul_InformationObject,
        owl:Thing .

:PlateStoringTask a owl:Class ;
    rdfs:label "PlateStoringTask"^^xsd:string ;
    rdfs:subClassOf :LabTaskType,
        owl:Thing ;
    owl:disjointWith :CalibratingTask,
        :ImagingTask,
        :IncubatingTask,
        :LiquidDispensingTask,
        :PlateRetrievingTask,
        :QuarantiningTask .

:Projection a owl:Class ;
    rdfs:label "Projection"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :projectsFrom ;
            owl:someValuesFrom :RobotWorldManipulationSystem ],
        [ a owl:Restriction ;
            owl:onProperty :abstractsAway ;
            owl:someValuesFrom :dul_Entity ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing .

:QueryVariable a owl:Class ;
    rdfs:label "QueryVariable"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :isBound ;
            owl:someValuesFrom xsd:boolean ],
        :dul_InformationObject,
        owl:Thing .

:RWMSStateTrajectory a owl:Class ;
    rdfs:label "RWMSStateTrajectory"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :trajOfSystem ;
            owl:someValuesFrom :RobotWorldManipulationSystem ],
        :BodyWorldTrajectory,
        owl:Thing .

:Realization a owl:Class ;
    rdfs:label "Realization"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :realizedInTrace ;
            owl:someValuesFrom :LabExecutionTrace ],
        :ExecutiveRealization,
        :RealizationSide,
        owl:Thing .

:RealizationSide a owl:Class ;
    rdfs:label "RealizationSide"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty :seamSideValue ],
        :SeamSituatedEntity,
        owl:Thing .

:RepairCandidateRef a owl:Class ;
    rdfs:label "RepairCandidateRef"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:SafetyPrecondition a owl:Class ;
    rdfs:label "SafetyPrecondition"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :isRequiredBy ;
            owl:someValuesFrom :OperatingProcedure ],
        :Precondition,
        owl:Thing ;
    owl:disjointWith :AuthorizationPrecondition,
        :PlacementPrecondition .

:SafetyStepDesignator a owl:Class ;
    rdfs:label "SafetyStepDesignator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :dischargesRule ;
            owl:someValuesFrom :LabSafetyRule ],
        :DeviceCommandDesignator,
        owl:Thing .

:SceneGroundedDesignator a owl:Class ;
    rdfs:label "SceneGroundedDesignator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :preservesEvidenceOf ;
            owl:someValuesFrom :MaterialScientificDesignator ],
        [ a owl:Restriction ;
            owl:onProperty :refines ;
            owl:someValuesFrom :MaterialScientificDesignator ],
        [ a owl:Restriction ;
            owl:onProperty :preservesGoalsOf ;
            owl:someValuesFrom :MaterialScientificDesignator ],
        :ScientificActionDesignator,
        owl:Thing .

:ScientificExecutive a owl:Class ;
    rdfs:label "ScientificExecutive"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :constructsWarrant ;
            owl:someValuesFrom :ScientificActionWarrant ],
        [ a owl:Restriction ;
            owl:onProperty :maintainsTwin ;
            owl:someValuesFrom :ExperimentalDigitalTwin ],
        [ a owl:Restriction ;
            owl:onProperty :addressesProblem ;
            owl:someValuesFrom :RobotScientistProblem ],
        :ManipulationExecutive,
        owl:Thing .

:ScientificModel a owl:Class ;
    rdfs:label "ScientificModel"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :predictsOver ;
            owl:someValuesFrom :ExperimentalDigitalTwin ],
        [ a owl:Restriction ;
            owl:onProperty :competesWith ;
            owl:someValuesFrom :ScientificModel ],
        [ a owl:Restriction ;
            owl:onProperty :supportRevisedBy ;
            owl:someValuesFrom :ExperimentalVerdict ],
        :dul_Description,
        owl:Thing .

:ScientificProposal a owl:Class ;
    rdfs:label "ScientificProposal"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :proposesActionFor ;
            owl:someValuesFrom :RobotScientistProblem ],
        :ActionProposalResource,
        owl:Thing .

:ScopedClaim a owl:Class ;
    rdfs:label "ScopedClaim"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :isUniversallyQuantified ;
            owl:someValuesFrom xsd:boolean ],
        [ a owl:Restriction ;
            owl:onProperty :establishedBy ;
            owl:someValuesFrom :ClaimWarrant ],
        :dul_Description,
        owl:Thing .

:Sensor a owl:Class ;
    rdfs:label "Sensor"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :mountedOn ;
            owl:someValuesFrom :Link ],
        [ a owl:Restriction ;
            owl:onProperty :partOf ;
            owl:someValuesFrom :RobotBody ],
        [ a owl:Restriction ;
            owl:onProperty :produces ;
            owl:someValuesFrom :SensorOutput ],
        :PhysicalEntity,
        :dul_PhysicalObject,
        owl:Thing ;
    owl:disjointWith :Motor .

:Signal a owl:Class ;
    rdfs:label "Signal"^^xsd:string ;
    rdfs:subClassOf :AbstractEntity,
        :dul_InformationObject,
        owl:Thing ;
    owl:disjointWith :ManipulationEpisode .

:SolvabilityRung a owl:Class ;
    rdfs:label "SolvabilityRung"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasRungFailureMode ;
            owl:someValuesFrom :SolvabilityFailureMode ],
        [ a owl:Restriction ;
            owl:onProperty :groundedInLayer ;
            owl:someValuesFrom :dul_Entity ],
        [ a owl:Restriction ;
            owl:onProperty :rungOf ;
            owl:someValuesFrom :SolvabilityStructure ],
        :dul_Description,
        owl:Thing .

:SubstrateSufficiency a owl:Class ;
    rdfs:label "SubstrateSufficiency"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :groundsProperty ;
            owl:someValuesFrom :CompetenceProperty ],
        [ a owl:Restriction ;
            owl:onProperty :mapsToRung ;
            owl:someValuesFrom :SubstrateRung ],
        :dul_Description,
        owl:Thing .

:ToolCenterPose a owl:Class ;
    rdfs:label "ToolCenterPose"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :affordsTaskType ;
            owl:someValuesFrom :PlateTransferTask ],
        :InteractionPose,
        owl:Thing ;
    owl:disjointWith :CalibrationPose,
        :ImagingTargetPose,
        :PipettingTargetPose,
        :RackPositionPose,
        :ToolCouplingPose,
        :WastePose .

:TrajectoryRef a owl:Class ;
    rdfs:label "TrajectoryRef"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:TranslationInterface a owl:Class ;
    rdfs:label "TranslationInterface"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :mapsFrom ;
            owl:someValuesFrom :System1Output ],
        [ a owl:Restriction ;
            owl:onProperty :interfaceOf ;
            owl:someValuesFrom :DualProcessManipulationExecutive ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isCommitmentSensitive ],
        [ a owl:Restriction ;
            owl:onProperty :producesTarget ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :Designator :ActionDesignator :RuntimeReasonablePlan :Constraint :ProcessMonitor :EvidenceRequirement :CriticHook ) ] ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing .

:TwinEntity a owl:Class ;
    rdfs:label "TwinEntity"^^xsd:string ;
    rdfs:subClassOf :RealizationSide,
        :dul_PhysicalObject,
        owl:Thing .

:UC1Warrant a owl:Class ;
    rdfs:label "UC1Warrant"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :dischargesConstraint ;
            owl:someValuesFrom :SterilityConstraint ],
        [ a owl:Restriction ;
            owl:onProperty :dischargesConstraint ;
            owl:someValuesFrom :AuditConstraint ],
        [ a owl:Restriction ;
            owl:onProperty :accountsForProgram ;
            owl:someValuesFrom :OpenAndInspectProgram ],
        [ a owl:Restriction ;
            owl:onProperty :dischargesConstraint ;
            owl:someValuesFrom :ForceConstraint ],
        :LabWarrant,
        owl:Thing .

:WarrantProtocolMessage a owl:Class ;
    rdfs:label "WarrantProtocolMessage"^^xsd:string ;
    rdfs:subClassOf :dul_Description,
        owl:Thing .

:WashWasteArea a owl:Class ;
    rdfs:label "WashWasteArea"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hostsObject ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :Autoclave :WasteStation ) ] ],
        :LabZone,
        owl:Thing ;
    owl:disjointWith :CellZone,
        :LogisticsArea,
        :ServiceCorridor .

:claimScope a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:string .

:compiledTo a owl:ObjectProperty .

:doseAU a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

:hasInteractionPose a owl:ObjectProperty .

:isAbout a owl:ObjectProperty .

:isHardConstraint a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:boolean .

:isMonitoredBy a owl:ObjectProperty .

:messageKindValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:integer .

:nextLink a owl:ObjectProperty .

:principleTag a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:string .

:routesTo a owl:ObjectProperty .

:sourceDocument a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:standardCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:string .

:uses a owl:ObjectProperty .

:Abstention a owl:Class ;
    rdfs:label "Abstention"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ActingMechanism a owl:Class ;
    rdfs:label "ActingMechanism"^^xsd:string ;
    rdfs:subClassOf :ExecutiveMechanism,
        owl:Thing .

:AuthorizationPrecondition a owl:Class ;
    rdfs:label "AuthorizationPrecondition"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :isRequiredBy ;
            owl:someValuesFrom :OperatingProcedure ],
        :Precondition,
        owl:Thing ;
    owl:disjointWith :PlacementPrecondition .

:BileAcid a owl:Class ;
    rdfs:label "BileAcid"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :precipitates ;
            owl:someValuesFrom :ApoptoticProcess ],
        :dul_PhysicalObject,
        owl:Thing .

:BiologicalState a owl:Class ;
    rdfs:label "BiologicalState"^^xsd:string ;
    rdfs:subClassOf :HybridBodyWorldState,
        owl:Thing .

:BodyMotion a owl:Class ;
    rdfs:label "BodyMotion"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :generatedBy ;
            owl:someValuesFrom :RobotBody ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :generatorAgnostic ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :freeSpace ],
        [ a owl:Restriction ;
            owl:onProperty :drivenBy ;
            owl:someValuesFrom :ActuatorInput ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Contact ;
            owl:onProperty :consequentialVia ],
        :PhysicalEntity,
        :dul_Event,
        owl:Thing ;
    owl:disjointWith :ActionToken,
        :DistributionalPlausible .

:ColdStorageDevice a owl:Class ;
    rdfs:label "ColdStorageDevice"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasEquipmentFunction ;
            owl:someValuesFrom :ColdStorageFunction ],
        :ManualLabEquipment,
        owl:Thing .

:CompetenceQuestion a owl:Class ;
    rdfs:label "CompetenceQuestion"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :raisedBy ;
            owl:someValuesFrom :ManipulationProblemClass ],
        [ a owl:Restriction ;
            owl:onProperty :answeredBy ;
            owl:someValuesFrom :CognitiveCapability ],
        :dul_Description,
        owl:Thing .

:Diagnosis a owl:Class ;
    rdfs:label "Diagnosis"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasPrecondition ;
            owl:someValuesFrom :Monitoring ],
        :CognitiveCapability,
        owl:Thing .

:GlobalStandard a owl:Class ;
    rdfs:label "GlobalStandard"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :judgesSystem ;
            owl:someValuesFrom :RobotWorldManipulationSystem ],
        [ a owl:Restriction ;
            owl:onProperty :standardOverFamily ;
            owl:someValuesFrom :ManipulationProblemClass ],
        :dul_Description,
        owl:Thing .

:Goal a owl:Class ;
    rdfs:label "Goal"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :goalScope ;
            owl:someValuesFrom :Phase ],
        :dul_Description,
        owl:Thing .

:LabSDTNode a owl:Class ;
    rdfs:label "LabSDTNode"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :usdPrimPath ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty :representsEntity ;
            owl:someValuesFrom :Entity ],
        :SceneNode,
        owl:Thing .

:LiverRegeneration a owl:Class ;
    rdfs:label "LiverRegeneration"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :regenerates ;
            owl:someValuesFrom :LiverOrganoid ],
        :dul_Event,
        owl:Thing .

:MeasurementValidityRule a owl:Class ;
    rdfs:label "MeasurementValidityRule"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :mitigatesHazard ;
            owl:someValuesFrom :MeasurementValidityHazard ],
        :LabSafetyRule,
        owl:Thing .

:PipettingTargetPose a owl:Class ;
    rdfs:label "PipettingTargetPose"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :affordsTaskType ;
            owl:someValuesFrom :LiquidDispensingTask ],
        :InteractionPose,
        owl:Thing ;
    owl:disjointWith :CalibrationPose,
        :ImagingTargetPose,
        :RackPositionPose,
        :WastePose .

:ProblemDomain a owl:Class ;
    rdfs:label "ProblemDomain"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasMember ;
            owl:someValuesFrom :GroundedManipulationProblem ],
        [ a owl:Restriction ;
            owl:onClass :ManipulationProblemClass ;
            owl:onProperty :generatedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :evidenceBaseFor ;
            owl:someValuesFrom :CompetenceClaim ],
        :AbstractEntity,
        :MetaLevelEntity,
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :ManipulationProblemClass .

:QuarantineStation a owl:Class ;
    rdfs:label "QuarantineStation"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasDirectComponent ;
            owl:someValuesFrom :KeySwitch ],
        [ a owl:Restriction ;
            owl:onProperty :hasDirectComponent ;
            owl:someValuesFrom :LockableDoor ],
        [ a owl:Restriction ;
            owl:onProperty :hasDeviceFunction ;
            owl:someValuesFrom :QuarantineFunction ],
        :LabArtifact,
        :LabAutomationDevice,
        owl:Thing .

:RecordRouting a owl:Class ;
    rdfs:label "RecordRouting"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :CellActionRecord ;
            owl:onProperty :classifiesRecord ],
        :dul_Concept,
        owl:Thing .

:RecoveryAction a owl:Class ;
    rdfs:label "RecoveryAction"^^xsd:string ;
    rdfs:subClassOf :ExecutiveAction,
        owl:Thing .

:SafetyConstraint a owl:Class ;
    rdfs:label "SafetyConstraint"^^xsd:string ;
    rdfs:subClassOf :RegulatoryConstraint,
        owl:Thing .

:SceneGraph a owl:Class ;
    rdfs:label "SceneGraph"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isDataStructureRealization ],
        [ a owl:Restriction ;
            owl:onProperty :hasRelationEdge ;
            owl:someValuesFrom :RelationEdge ],
        [ a owl:Restriction ;
            owl:onProperty :hasNode ;
            owl:someValuesFrom :SceneNode ],
        [ a owl:Restriction ;
            owl:onProperty :partitionedInto ;
            owl:someValuesFrom :CouplingAlignedSubtree ],
        [ a owl:Restriction ;
            owl:onClass :RoleAssignmentLayer ;
            owl:onProperty :hasRoleAssignmentLayer ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :StructuralRepresentation,
        :dul_InformationObject,
        owl:Thing .

:SceneNode a owl:Class ;
    rdfs:label "SceneNode"^^xsd:string ;
    rdfs:subClassOf :dul_InformationObject,
        owl:Thing .

:SceneStepDesignator a owl:Class ;
    rdfs:label "SceneStepDesignator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :boundToDevice ;
            owl:someValuesFrom :LabArtifact ],
        :LabActionDesignator,
        :SceneGroundedDesignator,
        owl:Thing ;
    owl:disjointWith :DeviceCommandDesignator,
        :MotionStepDesignator .

:ServiceCorridor a owl:Class ;
    rdfs:label "ServiceCorridor"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :adjoinsZone ;
            owl:someValuesFrom :CellZone ],
        :LabZone,
        owl:Thing ;
    owl:disjointWith :LogisticsArea .

:StorageRoom a owl:Class ;
    rdfs:label "StorageRoom"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hostsObject ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :ColdStorageDevice :StorageShelving ) ] ],
        :LabRoom,
        owl:Thing .

:SubstanceManipulationDesignator a owl:Class ;
    rdfs:label "SubstanceManipulationDesignator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :designatesAction ;
            owl:someValuesFrom :LabAction ],
        :LabActionDesignator,
        owl:Thing ;
    owl:disjointWith :ConnectingActionDesignator,
        :MaintenanceActionDesignator,
        :PerceptionDesignator,
        :RegulationActionDesignator .

:SubstrateRung a owl:Class ;
    rdfs:label "SubstrateRung"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :designerControllable ],
        :SolvabilityRung,
        owl:Thing ;
    owl:disjointWith :DesignRung .

:TaskRelativeClass a owl:Class ;
    rdfs:label "TaskRelativeClass"^^xsd:string ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :solution :repaired :prohibited :nonachieving ) ] .

:TaskStatus a owl:Class ;
    rdfs:label "TaskStatus"^^xsd:string ;
    rdfs:subClassOf :dul_InformationObject,
        owl:Thing .

:ToolCouplingPose a owl:Class ;
    rdfs:label "ToolCouplingPose"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :affordsTaskType ;
            owl:someValuesFrom :ToolExchangeTask ],
        :InteractionPose,
        owl:Thing ;
    owl:disjointWith :CalibrationPose,
        :ImagingTargetPose,
        :PipettingTargetPose,
        :RackPositionPose,
        :WastePose .

:XenobioticMetabolism a owl:Class ;
    rdfs:label "XenobioticMetabolism"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :producesMetabolite ;
            owl:someValuesFrom :ReactiveMetabolite ],
        :dul_Event,
        owl:Thing ;
    owl:disjointWith :GlutathioneConjugation .

:affordsRobotSkill a owl:ObjectProperty .

:concernsWell a owl:ObjectProperty .

:constrains a owl:ObjectProperty .

:dischargesConstraint a owl:ObjectProperty .

:establishedBy a owl:FunctionalProperty,
        owl:ObjectProperty .

:failureCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:string .

:generates a owl:ObjectProperty .

:hasPart a owl:ObjectProperty .

:isPoseOf a owl:ObjectProperty .

:isUniversallyQuantified a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:boolean .

:rungLevel a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:integer .

:statusCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:string .

:AssessmentRegime a owl:Class ;
    rdfs:label "AssessmentRegime"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isExecutiveIndependent ],
        [ a owl:Restriction ;
            owl:onProperty :producesVerdict ;
            owl:someValuesFrom :VerdictComponent ],
        [ a owl:Restriction ;
            owl:onProperty :governsClaim ;
            owl:someValuesFrom :CompetenceClaim ],
        [ a owl:Restriction ;
            owl:onProperty :appliesCritic ;
            owl:someValuesFrom :Critic ],
        :MetaLevelEntity,
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :EvidenceBearingTrace,
        :ManipulationExecutive .

:BWSRelativeTaskSpecification a owl:Class ;
    rdfs:label "BWSRelativeTaskSpecification"^^xsd:string ;
    rdfs:subClassOf :ManipulationProblem,
        owl:Thing .

:BodyWorldTrajectory a owl:Class ;
    rdfs:label "BodyWorldTrajectory"^^xsd:string ;
    rdfs:subClassOf :dul_Event,
        owl:Thing .

:CellZone a owl:Class ;
    rdfs:label "CellZone"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hostsObject ;
            owl:someValuesFrom :LaboratoryCell ],
        :LabZone,
        owl:Thing ;
    owl:disjointWith :LogisticsArea,
        :ServiceCorridor .

:ClaimWarrant a owl:Class ;
    rdfs:label "ClaimWarrant"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :warrantRangesOver ;
            owl:someValuesFrom :ManipulationProblem ],
        :dul_Description,
        owl:Thing .

:ConfigurationChangeDesignator a owl:Class ;
    rdfs:label "ConfigurationChangeDesignator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :designatesAction ;
            owl:someValuesFrom :LabAction ],
        :LabActionDesignator,
        owl:Thing ;
    owl:disjointWith :ConnectingActionDesignator,
        :MaintenanceActionDesignator,
        :PerceptionDesignator,
        :RegulationActionDesignator,
        :SubstanceManipulationDesignator .

:ConnectingActionDesignator a owl:Class ;
    rdfs:label "ConnectingActionDesignator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :designatesAction ;
            owl:someValuesFrom :LabAction ],
        :LabActionDesignator,
        owl:Thing ;
    owl:disjointWith :MaintenanceActionDesignator,
        :PerceptionDesignator,
        :RegulationActionDesignator .

:Constraint a owl:Class ;
    rdfs:label "Constraint"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "motionManifold"^^xsd:string ;
            owl:onProperty :governedBy ],
        [ a owl:Restriction ;
            owl:onProperty :characteristicFailure ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :Lock :Jam :MisdirectedForce ) ] ],
        :CouplingType,
        owl:Thing .

:DynamicModel a owl:Class ;
    rdfs:label "DynamicModel"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :structures ;
            owl:someValuesFrom :BodyDynamics ],
        [ a owl:Restriction ;
            owl:onProperty :relatesTorqueToAcceleration ;
            owl:someValuesFrom :Law ],
        [ a owl:Restriction ;
            owl:onClass :InertiaMatrix ;
            owl:onProperty :hasInertiaTerm ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :modelOf ;
            owl:someValuesFrom :RobotBody ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :KinematicModel .

:Evaluation a owl:Class ;
    rdfs:label "Evaluation"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasPrecondition ;
            owl:someValuesFrom :CounterfactualReasoning ],
        :CognitiveCapability,
        owl:Thing .

:FailureSignature a owl:Class ;
    rdfs:label "FailureSignature"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :detectedBy ;
            owl:someValuesFrom :ProcessMonitor ],
        [ a owl:Restriction ;
            owl:onProperty :bridges ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :PhysicalDeviation :SymbolicDiagnosis ) ] ],
        [ a owl:Restriction ;
            owl:onProperty :triggers ;
            owl:someValuesFrom :Diagnosis ],
        [ a owl:Restriction ;
            owl:onProperty :enumeratedBy ;
            owl:someValuesFrom :BodyWorldProcessMicrotheory ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :ProcessMonitor .

:ForbiddenTemplate a owl:Class ;
    rdfs:label "ForbiddenTemplate"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :templateForbiddenBy ;
            owl:someValuesFrom :LabConstraint ],
        :TrajectoryTemplate,
        owl:Thing ;
    owl:disjointWith :RequiredTemplate .

:Hepatocyte a owl:Class ;
    rdfs:label "Hepatocyte"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :constitutes ;
            owl:someValuesFrom :BiologicalSpecimen ],
        [ a owl:Restriction ;
            owl:onProperty :performsMetabolism ;
            owl:someValuesFrom :XenobioticMetabolism ],
        :dul_PhysicalObject,
        owl:Thing .

:ImagingDevice a owl:Class ;
    rdfs:label "ImagingDevice"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasDeviceFunction ;
            owl:someValuesFrom :ImagingFunction ],
        :LabAutomationDevice,
        owl:Thing .

:ImagingTargetPose a owl:Class ;
    rdfs:label "ImagingTargetPose"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :affordsTaskType ;
            owl:someValuesFrom :ImagingTask ],
        :InteractionPose,
        owl:Thing ;
    owl:disjointWith :CalibrationPose,
        :RackPositionPose,
        :WastePose .

:Joint a owl:Class ;
    rdfs:label "Joint"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :JointType ;
            owl:onProperty :hasJointType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :actuatedBy ;
            owl:someValuesFrom :Motor ],
        [ a owl:Restriction ;
            owl:onProperty :providesDOF ;
            owl:someValuesFrom :DegreeOfFreedom ],
        [ a owl:Restriction ;
            owl:onClass :Link ;
            owl:onProperty :connects ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        :PhysicalEntity,
        :dul_PhysicalObject,
        owl:Thing ;
    owl:disjointWith :Link .

:KnowledgeGraph a owl:Class ;
    rdfs:label "KnowledgeGraph"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :groundedIn ;
            owl:someValuesFrom :SomaOntology ],
        [ a owl:Restriction ;
            owl:onProperty :hasTriple ;
            owl:someValuesFrom :Triple ],
        [ a owl:Restriction ;
            owl:onProperty :producedFrom ;
            owl:someValuesFrom :SceneGraph ],
        [ a owl:Restriction ;
            owl:onProperty :isAbout ;
            owl:someValuesFrom :BodyWorldSystem ],
        [ a owl:Restriction ;
            owl:onProperty :classifiedBy ;
            owl:someValuesFrom :Reasoner ],
        :AbstractEntity,
        :dul_InformationObject,
        owl:Thing .

:LaboratoryCell a owl:Class ;
    rdfs:label "LaboratoryCell"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :partOfLaboratorySite ;
            owl:someValuesFrom :LaboratorySite ],
        :BodyWorldSystem,
        owl:Thing .

:Link a owl:Class ;
    rdfs:label "Link"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasPose ;
            owl:someValuesFrom :SpatialPose ],
        [ a owl:Restriction ;
            owl:onProperty :partOf ;
            owl:someValuesFrom :RobotBody ],
        [ a owl:Restriction ;
            owl:onProperty :connectedBy ;
            owl:someValuesFrom :Joint ],
        :PhysicalEntity,
        :dul_PhysicalObject,
        owl:Thing ;
    owl:disjointWith :Joint .

:LogisticsArea a owl:Class ;
    rdfs:label "LogisticsArea"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :adjoinsZone ;
            owl:someValuesFrom :CellZone ],
        :LabZone,
        owl:Thing .

:ManipulationControlProgram a owl:Class ;
    rdfs:label "ManipulationControlProgram"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :emits ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :ActionToken :ObservationRequest :Repair ) ] ],
        [ a owl:Restriction ;
            owl:onProperty :realizedAs ;
            owl:someValuesFrom :RealizationForm ],
        [ a owl:Restriction ;
            owl:onProperty :partOf ;
            owl:someValuesFrom :ManipulationExecutive ],
        [ a owl:Restriction ;
            owl:onProperty :consumes ;
            owl:someValuesFrom :Percept ],
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :ManipulationExecutiveOperatingSystem .

:ManualItem a owl:Class ;
    rdfs:label "ManualItem"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :statementText ;
            owl:someValuesFrom xsd:string ],
        :dul_Description,
        owl:Thing .

:Occasion a owl:Class ;
    rdfs:label "Occasion"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :ofFluentType ;
            owl:someValuesFrom :FluentType ],
        [ a owl:Restriction ;
            owl:onProperty :holdsInterval ;
            owl:someValuesFrom :TimeInterval ],
        :AbstractEntity,
        :dul_Situation,
        owl:Thing ;
    owl:disjointWith :Chronicle,
        :EventType,
        :Occurrence,
        :TimeInterval .

:PlacementPrecondition a owl:Class ;
    rdfs:label "PlacementPrecondition"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :isRequiredBy ;
            owl:someValuesFrom :OperatingProcedure ],
        :Precondition,
        owl:Thing .

:ProcessMonitor a owl:Class ;
    rdfs:label "ProcessMonitor"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :monitorFor ;
            owl:someValuesFrom :BodyWorldProcessMicrotheory ],
        [ a owl:Restriction ;
            owl:onProperty :producesRecordIn ;
            owl:someValuesFrom :EvidenceBearingTrace ],
        [ a owl:Restriction ;
            owl:onProperty :operationalizes ;
            owl:someValuesFrom :Expectation ],
        [ a owl:Restriction ;
            owl:onProperty :checks ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :Progress :Constraint :Effect :FailureSignature ) ] ],
        :AbstractEntity,
        :dul_Description,
        owl:Thing ;
    owl:disjointWith :FailureSignature .

:RealizationLink a owl:Class ;
    rdfs:label "RealizationLink"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :failureRoutesTo ;
            owl:someValuesFrom :Repair ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :canDepartFromPrediction ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :RealizationLink ;
            owl:onProperty :nextLink ],
        :dul_Description,
        owl:Thing .

:Recording a owl:Class ;
    rdfs:label "Recording"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isPartial ],
        [ a owl:Restriction ;
            owl:onProperty :isAbout ;
            owl:someValuesFrom :ManipulationEpisode ],
        :dul_InformationObject,
        owl:Thing ;
    owl:disjointWith :EvidenceBearingTrace,
        :ManipulationEpisode .

:RequiredTemplate a owl:Class ;
    rdfs:label "RequiredTemplate"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :templateRequiredBy ;
            owl:someValuesFrom :LabConstraint ],
        :TrajectoryTemplate,
        owl:Thing .

:Robot a owl:Class ;
    rdfs:label "Robot"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :ManipulationExecutive ;
            owl:onProperty :hosts ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :RobotBody ;
            owl:onProperty :hasProperPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :PhysicalEntity,
        :dul_PhysicalAgent,
        owl:Thing .

:SolvabilityFailureMode a owl:Class ;
    rdfs:label "SolvabilityFailureMode"^^xsd:string ;
    rdfs:subClassOf :dul_Description,
        owl:Thing .

:Substitution a owl:Class ;
    rdfs:label "Substitution"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :substitutesOn ;
            owl:someValuesFrom :Realization ],
        :dul_Description,
        owl:Thing .

:VirtualResearchLab a owl:Class ;
    rdfs:label "VirtualResearchLab"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :labProducesTrace ;
            owl:someValuesFrom :LabExecutionTrace ],
        :DigitalResearchLaboratory,
        owl:Thing .

:consumes a owl:ObjectProperty .

:groundedInLayer a owl:ObjectProperty .

:hasArm a owl:ObjectProperty .

:hasRungFailureMode a owl:ObjectProperty .

:monitorsEntity a owl:ObjectProperty .

:produces a owl:ObjectProperty .

:realizes a owl:ObjectProperty .

:ApoptoticProcess a owl:Class ;
    rdfs:label "ApoptoticProcess"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :antagonizes ;
            owl:someValuesFrom :CellRecoveryProcess ],
        :dul_Event,
        owl:Thing ;
    owl:disjointWith :CellRecoveryProcess .

:BiologicalSpecimen a owl:Class ;
    rdfs:label "BiologicalSpecimen"^^xsd:string ;
    rdfs:subClassOf :dul_PhysicalObject,
        owl:Thing .

:CellRobot a owl:Class ;
    rdfs:label "CellRobot"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasRobotSkill ;
            owl:someValuesFrom :RobotSkill ],
        [ a owl:Restriction ;
            owl:onProperty :servesStation ;
            owl:someValuesFrom :LabArtifact ],
        :LabArtifact,
        :Robot,
        owl:Thing .

:Chronicle a owl:Class ;
    rdfs:label "Chronicle"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :forwardBranching ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :maximal ],
        [ a owl:Restriction ;
            owl:onProperty :totallyOrders ;
            owl:someValuesFrom :TimeInstant ],
        :AbstractEntity,
        :dul_Region,
        owl:Thing ;
    owl:disjointWith :EventType,
        :FluentType,
        :Occasion,
        :Occurrence,
        :TimeInterval .

:CouplingType a owl:Class ;
    rdfs:label "CouplingType"^^xsd:string ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( :ForceClosure :Constraint :Process ) ] .

:DigitalBodyWorldSystem a owl:Class ;
    rdfs:label "DigitalBodyWorldSystem"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty :isPhysical ],
        [ a owl:Restriction ;
            owl:onProperty :hasStructuralCore ;
            owl:someValuesFrom :StructuralRepresentation ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isSpecification ],
        [ a owl:Restriction ;
            owl:onProperty :isModelOf ;
            owl:someValuesFrom :BodyWorldSystem ],
        [ a owl:Restriction ;
            owl:onProperty :hasPredictor ;
            owl:someValuesFrom :ExecutablePrediction ],
        [ a owl:Restriction ;
            owl:onProperty :hasExpectedObservation ;
            owl:someValuesFrom :ExpectedObservation ],
        [ a owl:Restriction ;
            owl:onProperty :hasScopeCard ;
            owl:someValuesFrom :ScopeCard ],
        :dul_InformationObject,
        owl:Thing .

:ExpectedObservation a owl:Class ;
    rdfs:label "ExpectedObservation"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :generatedBy ;
            owl:someValuesFrom :DigitalBodyWorldSystem ],
        :dul_InformationObject,
        owl:Thing ;
    owl:disjointWith :Observation .

:ExperimentalEvidenceTrace a owl:Class ;
    rdfs:label "ExperimentalEvidenceTrace"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasEvidenceFrame ;
            owl:someValuesFrom :EvidentialFrame ],
        [ a owl:Restriction ;
            owl:onProperty :recordsEpisode ;
            owl:someValuesFrom :ExperimentalEpisode ],
        :EvidenceBearingTrace,
        owl:Thing .

:LabAgentRole a owl:Class ;
    rdfs:label "LabAgentRole"^^xsd:string ;
    rdfs:subClassOf :dul_Description,
        owl:Thing .

:MaintenanceActionDesignator a owl:Class ;
    rdfs:label "MaintenanceActionDesignator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :designatesAction ;
            owl:someValuesFrom :LabAction ],
        :LabActionDesignator,
        owl:Thing ;
    owl:disjointWith :RegulationActionDesignator .

:ManualLabEquipment a owl:Class ;
    rdfs:label "ManualLabEquipment"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasEquipmentFunction ;
            owl:someValuesFrom :DeviceFunction ],
        :LabArtifact,
        owl:Thing .

:MaterialStateQuality a owl:Class ;
    rdfs:label "MaterialStateQuality"^^xsd:string ;
    rdfs:subClassOf :dul_Quality,
        owl:Thing .

:Occurrence a owl:Class ;
    rdfs:label "Occurrence"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :overInterval ;
            owl:someValuesFrom :TimeInterval ],
        [ a owl:Restriction ;
            owl:onProperty :ofEventType ;
            owl:someValuesFrom :EventType ],
        :AbstractEntity,
        :dul_Situation,
        owl:Thing ;
    owl:disjointWith :Chronicle,
        :FluentType,
        :Occasion,
        :TimeInterval .

:RackPositionPose a owl:Class ;
    rdfs:label "RackPositionPose"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :affordsTaskType ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :LiquidDispensingTask :TipHandlingTask ) ] ],
        :InteractionPose,
        owl:Thing ;
    owl:disjointWith :CalibrationPose,
        :WastePose .

:Theorem a owl:Class ;
    rdfs:label "Theorem"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :entailedBy ;
            owl:someValuesFrom :AxiomSet ],
        :AbstractEntity,
        :EpistemicObject,
        :MetaLevelEntity,
        :dul_Description,
        owl:Thing .

:TransformationFacetDesignator a owl:Class ;
    rdfs:label "TransformationFacetDesignator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :designatesAction ;
            owl:someValuesFrom :LabAction ],
        :LabActionDesignator,
        owl:Thing .

:VerdictComponent a owl:Class ;
    rdfs:label "VerdictComponent"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty :isCriticAssigned ],
        [ a owl:Restriction ;
            owl:onClass :ManipulationEpisode ;
            owl:onProperty :assesses ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue "verdict"^^xsd:string ;
            owl:onProperty :claimScope ],
        [ a owl:Restriction ;
            owl:onClass :AccountableDimension ;
            owl:onProperty :alongDimension ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
